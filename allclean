#!/bin/bash

export SRC_TREE_ROOT=`pwd`
if [ ! -e ${SRC_TREE_ROOT}/cloonix/cloonix_config.py ]; then
  echo NOT FOUND:
  echo ${SRC_TREE_ROOT}/cloonix/cloonix_config.py
  exit 1
fi

BUNDLE="${HOME}/cloonix_bundle"
rm -rf ${BUNDLE}
${SRC_TREE_ROOT}/httpdoc/allclean
# python leaves one beside every module it imports: cloonix/, debug/, demos/
find ${SRC_TREE_ROOT} -name __pycache__ -type d -prune -exec rm -rf {} +
CLOONSRC=${SRC_TREE_ROOT}/cloonix/cloonsrc
  for i in lib_io_clownix \
           lib_rpc_clownix; do
    cd ${CLOONSRC}/${i}
    ./allclean
  done
  for i in  doorways \
            proxymous_passt \
            suid_power \
            uml_cloonix_switch \
            insider_agents/cloonix_agent ; do
    cd ${CLOONSRC}/${i}
    make clean
  done 
  cd ${CLOONSRC}/dtach
  ./allclean
  rm -f ${CLOONSRC}/cloonix-proxymous
  for i in jscloonix \
           ovs \
           proxymous_passt \
           ovs_drv \
           ovs_snf \
           ovs_nat_passt \
           ovs_c2c \
           ovs_a2b \
           qemu \
           crun \
           cxp_cli ; do
    cd ${CLOONSRC}/${i}
    ./allclean
  done
  rm -f ${CLOONSRC}/insider_agents/insider_agent_x86_64.iso
  rm -f ${CLOONSRC}/insider_agents/insider_agent_win_x86_64.iso
  rm -rf ${CLOONSRC}/insider_agents/cdrom
  rm -rf ${CLOONSRC}/insider_agents/cdrom_win
  rm -rf cloonix/__pycache__
