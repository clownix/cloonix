NET_RE = re.compile(r"CLOONIX_NET\s*:\s*(\S+)\s*\{(.*?)\}", re.S)
VER_RE = re.compile(r"CLOONIX_VERSION\s*=\s*(\S+)")

def cfg_version(text):
    m = VER_RE.search(text)
    return m.group(1) if m else "unknown"

CFG_VERSION = "?"

def parse_cfg(text):
    """Return {net_name: {key: value}} from a cloonix.cfg body."""
    nets = {}
    for name, block in NET_RE.findall(text):
        entry = {}
        for line in block.splitlines():
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            parts = line.split(None, 1)
            if len(parts) == 2:
                key, val = parts
                entry[key] = val.strip()
        if entry:
            nets[name] = entry
    return nets

def load_config(explicit=None):
    """The nets of cloonix_config.py, or of the file --cfg names.

    Returns (nets, where they came from). No config is not fatal: -s names a
    server itself, and every verb that needs a net says what is missing."""
    global CFG_VERSION
    nets, origin = {}, "none"
    cfg = load_sibling("cloonix_config")
    if cfg:
        nets = parse_cfg(cfg.CONFIG)
        origin = "cloonix_config.py"
        CFG_VERSION = cfg_version(cfg.CONFIG)
    if explicit:
        if not os.path.isfile(explicit):
            raise SystemExit("no such config file: %s" % explicit)
        try:
            with open(explicit, "r") as f:
                text = f.read()
        except OSError as err:
            raise SystemExit("cannot read %s: %s" % (explicit, err))
        nets.update(parse_cfg(text))
        origin = explicit
        CFG_VERSION = cfg_version(text)
    return nets, origin

def resolve(net, nets, override=None):
    """(ip, port, passwd) for a net name, or from a host:port:passwd string."""
    if override:
        bits = override.split(":")
        if len(bits) != 3:
            raise SystemExit("-s wants host:port:passwd")
        return bits[0], int(bits[1]), bits[2]
    if not nets:
        raise SystemExit(
            "no configuration: cloonix_config.py is not beside this client.\n"
            "It carries the nets, their ports and their passwords, and the\n"
            "install puts it in /usr/bin with cloonix. Copy it there, or name\n"
            "another with --cfg, or give the server with -s host:port:passwd.")
    if net not in nets:
        raise SystemExit("unknown net '%s' (known: %s)"
                         % (net, ", ".join(sorted(nets))))
    e = nets[net]
    try:
        return e["cloonix_ip"], int(e["cloonix_port"]), e["cloonix_passwd"]
    except (KeyError, ValueError):
        raise SystemExit("net '%s' is missing ip, port or passwd" % net)
MSG_DIGEST_LEN = 32
HDR = 16 + MSG_DIGEST_LEN                  # doorways_header_size() == 48
MAX_BUF = 50000                            # MAX_DOORWAYS_BUF_LEN

# Must match glob_wire.h (CLOONIX_WIRE_VERSION and the enums below);
# debug/check_wire.sh checks it.
CLOONIX_WIRE_VERSION = 79

DOORS_TYPE_SWITCH = 104                    # doors_type_switch
DOORS_TYPE_DBSSH = 107                     # doors_type_dbssh
DOORS_VAL_NONE = 202                       # doors_val_none
DOORS_VAL_C2C = 201                        # doors_val_c2c
DOORS_VAL_INIT_LINK = 204                  # doors_val_init_link
DOORS_VAL_LINK_OK = 205                    # doors_val_link_ok
DOORS_VAL_LINK_KO = 206                    # doors_val_link_ko
# The leg request has a mandatory cookie field, and doorways drops its first 4
# characters before relaying it.
CXP_COOKIE = "0000cxp"

JSON_MAGIC = b"\xca\xfe\xde\xca\xca\xfe\xde\xca"

def hmac_key(passwd):
    return passwd.encode()[:MSG_DIGEST_LEN].ljust(MSG_DIGEST_LEN, b"\0")

def frame(passwd, payload, tid=0, type_=DOORS_TYPE_SWITCH,
          val=DOORS_VAL_NONE, nb_pkt=1):
    if isinstance(payload, str):
        payload = payload.encode()
    digest = hmac.new(hmac_key(passwd), payload, hashlib.sha256).digest()
    return (b"\xca\xfe"
            + struct.pack(">HIHHH", tid & 0xFFFF, len(payload),
                          type_ & 0xFFFF, val & 0xFFFF, nb_pkt & 0xFFFF)
            + digest + b"\xde\xca" + payload)

def unframe(buf, passwd, check=True):
    """(consumed, tid, type, val, payload) or (0, ...) when incomplete."""
    if len(buf) < HDR:
        return 0, None, None, None, None
    if buf[0] != 0xCA or buf[1] != 0xFE:
        raise IOError("bad doorways magic %02x%02x" % (buf[0], buf[1]))
    tid, ln, type_, val, _nb = struct.unpack(">HIHHH", buf[2:14])
    if buf[46] != 0xDE or buf[47] != 0xCA:
        raise IOError("bad doorways header tail")
    if ln > MAX_BUF:
        raise IOError("doorways length %d out of range" % ln)
    if len(buf) < HDR + ln:
        return 0, None, None, None, None
    payload = buf[HDR:HDR + ln]
    if check:
        want = hmac.new(hmac_key(passwd), payload, hashlib.sha256).digest()
        if not hmac.compare_digest(want, bytes(buf[14:46])):
            raise IOError("doorways hmac mismatch: wrong cloonix_passwd?")
    return HDR + ln, tid, type_, val, payload

def tls_connect(ip, port, timeout):
    """The doors tcp socket, wrapped in tls.

    The certificate is the server's self-signed one, not verified: the hmac on
    every frame authenticates, tls gives the confidentiality. A server that
    closes during the handshake, an older cloonix or one without a certificate,
    is spoken to again in clear, said on stderr, unless CLOONIX_REQUIRE_TLS=1,
    which refuses.
    """
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    # Only a server that CLOSES on the hello is one without tls.
    why = ""
    for attempt in (1, 2):
        sock = socket.create_connection((ip, port), timeout)
        try:
            return ctx.wrap_socket(sock)
        except socket.timeout:
            sock.close()
            raise
        except (ssl.SSLEOFError, ConnectionResetError, BrokenPipeError):
            sock.close()
            why = "closed the socket on the client hello"
            break
        except (ssl.SSLError, OSError) as err:
            sock.close()
            why = str(err)
    if os.environ.get("CLOONIX_REQUIRE_TLS") == "1":
        raise IOError("%s:%d does not speak tls (%s) and CLOONIX_REQUIRE_TLS=1 "
                      "refuses an unencrypted connection" % (ip, port, why))
    sys.stderr.write("cloonix: %s:%d does not speak tls (%s), the connection "
                     "is not encrypted\n" % (ip, port, why))
    return socket.create_connection((ip, port), timeout)

class Doorways:
    """A client leg of the cloonix doorways tcp port."""

    def __init__(self, ip, port, passwd, timeout=15):
        self.passwd = passwd
        self.timeout = timeout
        self.nb_pkt = 0
        self.quiet = False
        self.buf = bytearray()
        self.sock = tls_connect(ip, port, timeout)
        self.sock.settimeout(timeout)
        self._open_link()

    def _open_link(self):
        """doorways_sig_bufraw(.., doors_type_switch, doors_val_init_link,
        "OK"), then the answer, doors_val_link_ok of dispach.c.

        A close instead is ambiguous: a wrong password, or a server shutting
        down or refusing new clients, get_inhib_new_clients() of
        recv_from_client.c.
        """
        self.send_raw("OK", val=DOORS_VAL_INIT_LINK)
        self.sock.settimeout(min(5, self.sock.gettimeout() or 5))
        try:
            got = self.recv()
        except IOError as err:
            raise IOError("%s" % err)
        finally:
            self.sock.settimeout(self.timeout)
        if got is None:
            raise IOError("the server closed the connection right after the "
                          "link request, without saying why. Two things do "
                          "that: a cloonix_passwd that does not match the "
                          "running server, or a server that is shutting "
                          "down or refusing new clients. If nothing changed "
                          "the config, it is the second")
        _type, val, _payload = got
        if val == DOORS_VAL_LINK_KO:
            raise IOError("the server refused the link")

    def send_raw(self, payload, tid=0, type_=DOORS_TYPE_SWITCH,
                 val=DOORS_VAL_NONE):
        self.nb_pkt = 1 if self.nb_pkt >= 0xFFFF else self.nb_pkt + 1
        self.sock.sendall(frame(self.passwd, payload, tid, type_, val,
                                self.nb_pkt))

    def send_json(self, obj, val=DOORS_VAL_NONE):
        self.send_raw(JSON_MAGIC + json.dumps(obj, separators=(",", ":"))
                      .encode(), val=val)

    def recv(self):
        """Next (type, val, payload_bytes), or None.

        None is a close or a silent timeout; quiet says which, True for
        silence. probe reads it: a far end that says nothing is healthy, one
        that hangs up is not.
        """
        self.quiet = False
        while True:
            consumed, _tid, type_, val, payload = unframe(self.buf, self.passwd)
            if consumed:
                del self.buf[:consumed]
                return type_, val, payload
            try:
                chunk = self.sock.recv(65536)
            except socket.timeout:
                self.quiet = True
                return None
            if not chunk:
                return None
            self.buf += chunk

    def recv_json(self):
        """Next decodable json payload, skipping link keepalives."""
        while True:
            got = self.recv()
            if got is None:
                return None
            _type, val, payload = got
            if val in (DOORS_VAL_INIT_LINK, DOORS_VAL_LINK_OK):
                continue
            if val == DOORS_VAL_LINK_KO:
                raise IOError("server refused the link (bad password?)")
            # The answer carries the same magic in front of the text.
            body = payload
            pos = body.find(JSON_MAGIC)
            if pos >= 0:
                body = body[pos + len(JSON_MAGIC):]
            try:
                return json.loads(body.decode("utf-8", "replace"))
            except ValueError:
                return {"raw": body.decode("utf-8", "replace")}

    def no_timeout(self):
        """Block indefinitely on reads.

        The timeout bounds the connect and the short exchanges of cli; a
        session, a shell, a command or a transfer, is not bounded: a quiet
        command is at work, not stuck.
        """
        self.sock.settimeout(None)

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass
ENDP_NONE, ENDP_ETHS, ENDP_ETHV = 13, 14, 15
FLAG_PERSISTENT    = 0x00001
FLAG_FULL_VIRT     = 0x00008
FLAG_INSTALL_CDROM = 0x00020
FLAG_NO_REBOOT     = 0x00040
FLAG_ADDED_CDROM   = 0x00080
FLAG_ADDED_DISK    = 0x00100
FLAG_NO_QEMU_GA    = 0x00200
FLAG_WINDOWS       = 0x00400
FLAG_UEFI          = 0x00800
FLAG_FREEBSD       = 0x01000

WINDOWS_DRIVER_ISO = "virtio-win.iso"

def eth_table(nb_eth, macs=None):
    """eth=<n> -> the eth_table list add_vm and cnt_add expect: n interfaces
    born not capturable, cnf <n> eth<i> sniff=on makes one so.

    macs is {index: [6 bytes]} from mac_addr=. An interface named there
    gets randmac 0 and that address; every other one keeps a random mac,
    which is what the daemon does with randmac 1.
    """
    macs = macs or {}
    return [{"endp_type": ENDP_ETHV, "randmac": 0 if macs.get(i) else 1,
             "ifname": "noname", "mac": macs.get(i) or [0, 0, 0, 0, 0, 0]}
            for i in range(nb_eth)]

def parse_mac_addr(spec, nb_eth):
    """'eth0:aa:bb:cc:dd:ee:ff' -> (0, [0xaa, ...]), the way lst prints it."""
    head, _, rest = spec.partition(":")
    if not head.startswith("eth") or not head[3:].isdigit():
        raise SystemExit("mac_addr= wants eth<n>:<6 bytes>, got '%s'" % spec)
    idx = int(head[3:])
    if idx >= nb_eth:
        raise SystemExit("mac_addr=%s names an interface this machine has "
                         "not got: eth= gives %d" % (spec, nb_eth))
    try:
        mac = [int(b, 16) for b in rest.split(":")]
    except ValueError:
        raise SystemExit("mac_addr= wants hex bytes, got '%s'" % spec)
    if len(mac) != 6 or any(b > 0xFF or b < 0 for b in mac):
        raise SystemExit("mac_addr= wants 6 bytes, got '%s'" % spec)
    return idx, mac

def parse_kv(args):
    """Split ram=/cpu=/eth= and --flags out of a positional argument list.

    A key may repeat: mac_addr= names one interface, so a machine with
    three forced macs gives it three times. The values are kept as a list
    and the readers take the last one where only one makes sense.
    """
    kv, flags, rest = {}, [], []
    for a in args:
        # --key=value is a value, not a flag: refuse_unknown names it, where
        # dropping it among the flags built a guest without a word.
        if a.startswith("--") and "=" in a:
            k, _, v = a.partition("=")
            kv.setdefault(k, []).append(v)
        elif a.startswith("--"):
            flags.append(a)
        elif "=" in a and not a.startswith("-"):
            k, _, v = a.partition("=")
            kv.setdefault(k, []).append(v)
        else:
            rest.append(a)
    return kv, flags, rest

MAX_PUBLISH = 16

def build_nat_ports(kv):
    """The publish= values of a nat, as the one string sent.

    publish=none is how a nat is told to publish nothing, which only cnf
    has any use for: an add with no publish= at all already means that.
    """
    given = kv.get("publish", [])
    if any(w.lower() == "none" for w in given):
        if len(given) > 1:
            sys.exit("publish=none takes the ports away, so it cannot be "
                     "given beside one")
        return "none"
    out = []
    for spec in given:
        body, _, proto = spec.partition("/")
        proto = (proto or "tcp").lower()
        host, sep, guest = body.partition(":")
        if proto not in ("tcp", "udp"):
            sys.exit("publish=%s: the protocol is tcp or udp, not %r"
                     % (spec, proto))
        if not sep or not host.isdigit() or not guest.isdigit():
            sys.exit("publish=%s: expected hostport:guestport, the way\n"
                     "  docker publishes one:  publish=8080:80" % spec)
        for port in (int(host), int(guest)):
            if not 1 <= port <= 65535:
                sys.exit("publish=%s: %d is not a port" % (spec, port))
        out.append("%s:%d:%d" % (proto, int(host), int(guest)))
    if len(out) > MAX_PUBLISH:
        sys.exit("publish= given %d times; %d is the most a nat takes"
                 % (len(out), MAX_PUBLISH))
    return ",".join(out) if out else "none"

def one(kv, key, default=""):
    """The last value given for a key, or the default."""
    got = kv.get(key)
    return got[-1] if got else default

def refuse_unknown(kind, kv, flags, known_kv, known_flags):
    """Refuse a word this client would otherwise drop.

    Every option is read as well as parsed: one accepted and ignored builds a
    guest other than the one its dump commands line describes.
    """
    bad = ([k + "=" for k in kv if k not in known_kv]
           + [f for f in flags if f not in known_flags])
    if bad:
        raise SystemExit("add %s does not take %s\n"
                         "it takes: %s"
                         % (kind, " ".join(sorted(bad)),
                            " ".join(sorted([k + "=" for k in known_kv]
                                            + known_flags))))

KVM_FLAGS = ["--persistent", "--no_qemu_ga", "--fullvirt",
             "--uefi", "--no_reboot"]
KVM_KV = {"install_cdrom": FLAG_INSTALL_CDROM,
          "added_cdrom": FLAG_ADDED_CDROM,
          "added_disk": FLAG_ADDED_DISK}
KVM_FLAG_BIT = {"--persistent": FLAG_PERSISTENT,
                "--no_qemu_ga": FLAG_NO_QEMU_GA,
                "--fullvirt": FLAG_FULL_VIRT,
                "--uefi": FLAG_UEFI,
                "--freebsd": FLAG_FREEBSD,
                "--no_reboot": FLAG_NO_REBOOT}

def wlan_count(kv):
    """wlan=N, the radios."""
    return whole(one(kv, "wlan", 0) or 0, "wlan")

def megabytes(text, what):
    """ram=2000, ram=512M, ram=2G: megabytes."""
    m = re.match(r"^(\d+)([mMgG]?)[bB]?$", str(text))
    if not m:
        sys.exit("%s=%s: megabytes, or a number followed by M or G"
                 % (what, text))
    return int(m.group(1)) * (1024 if m.group(2).lower() == "g" else 1)

def whole(text, what):
    """cpu=2, eth=3, wlan=1: a whole number."""
    if not str(text).isdigit():
        sys.exit("%s=%s: a whole number" % (what, text))
    return int(text)

def build_add_vm(name, kv, flags, rootfs, kind=()):
    """kind: the flags add win and add freebsd stand for."""
    refuse_unknown("kvm", kv, flags,
                   list(KVM_KV) + ["mac_addr", "wlan", "ram", "cpu", "eth"],
                   KVM_FLAGS)
    flags = flags + list(kind)
    cfg_flags = 0
    for f in flags:
        cfg_flags |= KVM_FLAG_BIT.get(f, 0)
    disc = dict((k, one(kv, k)) for k in KVM_KV)
    if "--windows" in flags:
        cfg_flags |= FLAG_WINDOWS | FLAG_FULL_VIRT
        if not disc["added_cdrom"]:
            disc["added_cdrom"] = WINDOWS_DRIVER_ISO
    for opt, bit in KVM_KV.items():
        if disc[opt]:
            cfg_flags |= bit
    nb_eth = whole(one(kv, "eth", 0) or 0, "eth")
    macs = dict(parse_mac_addr(m, nb_eth) for m in kv.get("mac_addr", []))
    eth = eth_table(nb_eth, macs)
    return {"fctident": "add_vm", "tid": 0, "name": name, "vm_id": 0,
            "color": 0, "vm_config_flags": cfg_flags,
            "mem": megabytes(one(kv, "ram", 1000), "ram"),
            "cpu": whole(one(kv, "cpu", 1), "cpu"),
            "nb_tot_nb_vwif": wlan_count(kv),
            "nb_tot_eth": len(eth), "eth_table": eth,
            "rootfs_input": rootfs,
            "install_cdrom": disc["install_cdrom"],
            "added_cdrom": disc["added_cdrom"],
            "added_disk": disc["added_disk"],
            "rootfs_used": "", "rootfs_backing": ""}

def build_cnt_add(name, kv, flags, image):
    refuse_unknown("cnt", kv, flags,
                   ["startup_env", "vmount", "wlan", "mac_addr", "eth"],
                   ["--persistent"])
    nb_eth = whole(one(kv, "eth", 0) or 0, "eth")
    macs = dict(parse_mac_addr(m, nb_eth) for m in kv.get("mac_addr", []))
    eth = eth_table(nb_eth, macs)
    return {"fctident": "cnt_add", "tid": 0, "brandtype": "brandcnt",
            "name": name,
            "is_persistent": 1 if "--persistent" in flags else 0,
            "is_privileged": 0,
            "vm_id": 0, "color": 0, "image": image, "ping_ok": 0,
            "nb_tot_nb_vwif": wlan_count(kv),
            "nb_tot_eth": len(eth), "eth_table": eth,
            "startup_env": one(kv, "startup_env"),
            "vmount": one(kv, "vmount")}

CFG_ORIGIN = "none"

def connect_error(ip, port, err, net=None):
    """Say what went wrong, a refusal apart from an outage.

    A close right after the hmac is a password mismatch, not a dead server:
    usually the config replaced while the net runs, the server keeping the
    password it started with.
    """
    text = str(err)
    if "hmac" in text:
        # An hmac mismatch is the ONE case the server states outright, so it
        # is the only one this claims.
        return ("the server rejected our signature: WRONG PASSWORD for %s"
                % (net or "this net"),
                "the password this client used came from: %s\n"
                "it must match cloonix_passwd where that server was\n"
                "installed -- cloonfs/etc/cloonix.cfg there, the same file\n"
                "as this one when both machines run the same delivery"
                % CFG_ORIGIN,
                ("cloonix cli %s dump config" % (net or "<net>"),))
    return ("cannot reach the cloonix server", text,
            ("cloonix start %s" % (net or "<net>"),
             "cloonix list      to see which nets answer"))

def ip_to_int(text):
    """The encoding ip_string_to_int() uses in msg_layer.c: the four bytes
    packed big-endian into a uint32."""
    parts = (text or "").split(".")
    if len(parts) != 4:
        raise SystemExit("bad ip in the config: %r" % text)
    n = 0
    for p in parts:
        v = int(p)
        if not 0 <= v <= 255:
            raise SystemExit("bad ip in the config: %r" % text)
        n = (n << 8) + v
    return n

def build_c2c_add(name, slave_net, nets, local_net):
    """add c2c <name> <distant_net>.

    The message carries the settings of both ends, exactly as cmd_add_c2c()
    in ctrl assembles them: this side contributes the udp address and the
    bottom of its udp port range, the far side its address, port, password
    and udp address."""
    if not local_net:
        raise SystemExit("add c2c needs the net name, so the local udp "
                         "settings can be read: use a net rather than -s")
    if local_net not in nets:
        raise SystemExit("unknown local net '%s'" % local_net)
    if slave_net not in nets:
        raise SystemExit("unknown c2c destination '%s' (known: %s)"
                         % (slave_net, ", ".join(sorted(nets))))
    here, there = nets[local_net], nets[slave_net]
    try:
        return {"fctident": "c2c_add", "tid": 0, "name": name,
                "local_udp_ip": ip_to_int(here["c2c_udp_ip"]),
                "slave_net": slave_net,
                "ip": ip_to_int(there["cloonix_ip"]),
                "port": int(there["cloonix_port"]) & 0xFFFF,
                "passwd": there["cloonix_passwd"],
                "udp_ip": ip_to_int(there["c2c_udp_ip"]),
                "c2c_udp_port_low": int(here["c2c_udp_port_low"])}
    except KeyError as err:
        raise SystemExit("net %s or %s is missing %s in the config"
                         % (local_net, slave_net, err))

def to_json(argv, nets=None, local_net=None):
    """One command line -> the json to put on the wire, or None.

    The net has already been taken off the front, so argv[0] is the verb and
    what follows is its own.
    """
    if not argv:
        return None
    verb = argv[0]
    a = argv[1:]

    if verb == "add":
        if not a:
            return None
        what, rest = a[0], a[1:]
        kv, flags, pos = parse_kv(rest)
        if what == "kvm" and len(pos) >= 2:
            return build_add_vm(pos[0], kv, flags, pos[-1])
        if what == "win" and len(pos) >= 2:
            return build_add_vm(pos[0], kv, flags, pos[-1],
                                ("--windows", "--uefi"))
        if what == "freebsd" and len(pos) >= 2:
            return build_add_vm(pos[0], kv, flags, pos[-1], ("--freebsd",))
        if what == "cisco" and len(pos) >= 2:
            return build_add_vm(pos[0], kv, flags + ["--no_qemu_ga"],
                                pos[-1])
        if what == "cnt" and len(pos) >= 2:
            return build_cnt_add(pos[0], kv, flags, pos[-1])
        if what == "tap" and pos:
            return {"fctident": "tap_add", "tid": 0, "name": pos[0]}
        if what == "nat" and len(pos) == 1:
            if flags or any(k != "publish" for k in kv):
                sys.exit("add nat takes publish=hostport:guestport[/udp] "
                         "and nothing else")
            return {"fctident": "nat_add", "tid": 0, "name": pos[0],
                    "ports": build_nat_ports(kv)}
        if what == "a2b" and pos:
            return {"fctident": "a2b_add", "tid": 0, "name": pos[0]}
        if what == "c2c" and len(pos) == 2:
            return build_c2c_add(pos[0], pos[1], nets or {}, local_net)
        if what == "phy" and pos:
            # absorbed by default, --macvlan leaves it to the host
            if len(pos) > 1 or kv or any(f != "--macvlan" for f in flags):
                sys.exit("add phy <host interface> [--macvlan], nothing else")
            return {"fctident": "phy_add", "tid": 0, "name": pos[0],
                    "type": ENDP_PHYMV if flags else ENDP_PHYAV}
        return None

    # plug <n> [<interface>] <lan>; unplug <n> [<interface>] [<lan>], the
    # lan of an unplug found in the topology when not given
    if verb == "plug" and len(a) in (2, 3):
        if is_iface(a[-1]):
            sys.exit("plug %s: %s%s is the word of an interface, and a lan "
                     "or an air is never named so"
                     % (spoken(a), "the lan is missing; " if len(a) == 2
                        else "", a[-1]))
        return {"fctident": "add_lan_endp", "tid": 0, "name": a[0],
                "num": iface_num(a[1]) if len(a) == 3 else 0, "lan": a[-1]}
    if verb == "unplug" and len(a) in (1, 2, 3):
        itf = a[1] if len(a) > 1 and is_iface(a[1]) else None
        lan = a[2] if len(a) == 3 else (a[1] if len(a) == 2 and not itf
                                        else "")
        if len(a) == 3 and not itf:
            return None
        return {"fctident": "del_lan_endp", "tid": 0, "name": a[0],
                "num": iface_num(itf) if itf else 0, "lan": lan}

    if verb == "del" and len(a) == 1:
        if a[0] == "all":
            return {"fctident": "del_all", "tid": 0}
        return {"fctident": "del_name", "tid": 0, "name": a[0]}

    if verb == "cnf":
        return build_cnf(a)

    if verb == "save" and len(a) == 2:
        return {"fctident": "sav_vm", "tid": 0, "name": a[0], "path": a[1]}
    if verb == "stop":
        return {"fctident": "kill_uml_clownix", "tid": 0}
    if verb == "dump" and a:
        if a[0] in OVS_TOOLS:
            if len(a) == 1:
                return None
            return {"fctident": "ovs_cmd_req", "tid": 0, "tool": a[0],
                    "args": " ".join(a[1:])}
        # ip <nat> <guest>: the address the nat gave the guest
        if a[0] == "ip" and len(a) == 3:
            return {"fctident": "nat_cnf", "tid": 0, "name": a[1],
                    "cmd": "whatip=" + a[2]}
        if a[0] == "namespaces" and len(a) == 1:
            return {"fctident": "ovs_cmd_req", "tid": 0,
                    "tool": "namespaces", "args": ""}
        if len(a) == 1:
            return DUMP_REQ.get(a[0])
    return None

# The airs the radios start on, cnt and kvm.
CNTWIFI = "cntwifi"
KVMWIFI = "kvmwifi"

ENDP_PHYAV = 23
ENDP_PHYMV = 25
WLAN_NUM_BASE = 256

A2B_SIDE = {"A": 0, "B": 1}
A2B_DIR = {"A2B": 0, "B2A": 1}

def is_iface(word):
    """eth<i>, wlan<i> of a guest, A or B of an a2b."""
    return bool(re.match(r"^(eth|wlan)\d+$", word)) or word in A2B_SIDE

def iface_num(word):
    """An interface as the wire carries it: eth<i> is i, wlan<i> is
    WLAN_NUM_BASE + i, side A of an a2b 0 and B 1."""
    for pfx, base in (("eth", 0), ("wlan", WLAN_NUM_BASE)):
        if word.startswith(pfx) and word[len(pfx):].isdigit():
            return base + int(word[len(pfx):])
    if word in A2B_SIDE:
        return A2B_SIDE[word]
    sys.stderr.write("'%s' is not an interface: eth<i> or wlan<i> of a "
                     "guest, A or B of an a2b\n" % word)
    sys.exit(EXIT_LOCAL)

A2B_SETTINGS = ("delay", "loss", "rate", "silentms", "qsize", "bsize")

def a2b_cmd(words):
    """cnf <a2b> A2B|B2A delay=50, or replace_ipsrc <ip> with <ip>, or
    unreplace_ipdst, as the server reads it: dir=0 cmd=delay val=50."""
    d, rest = A2B_DIR[words[0]], words[1:]
    k, eq, v = rest[0].partition("=") if rest else ("", "", "")
    if len(rest) == 1 and eq and k in A2B_SETTINGS and v.isdigit():
        return "dir=%d cmd=%s val=%s" % (d, k, v)
    if rest and rest[0] in ("replace_ipsrc", "replace_ipdst",
                            "unreplace_ipsrc", "unreplace_ipdst"):
        return " ".join(["dir=%d" % d] + rest)
    sys.exit("cnf <a2b> %s: one of %s=<n>, or replace_ipsrc|replace_ipdst "
             "<ip> with <ip>, or unreplace_ipsrc|unreplace_ipdst"
             % (words[0], "=<n>, ".join(A2B_SETTINGS)))

# The keys of cnf, and the kind of object each is for: no two kinds share a
# key, so the kind of the name is read from what is asked of it.
CNF_KEYS = {
    "sniff":      "sniff",
    "angle":      "angle",
    "x":          "place",
    "y":          "place",
    "publish":    "nat",
    "cpu":        "cnt",
    "ram":        "cnt",
    "rstp":       "lan",
    "mac_mangle": "c2c",
}

# a note is text: the switch counts it in bytes, utf-8
MAX_NOTE = 100

CNF_SYNTAX = ("cnf <name> [eth<i>|A|B] sniff=on|off\n"
              "cnf <name> x=<x> y=<y>, on the canvas and pinned there\n"
              "cnf <name> note=\"<text>\", shown on the canvas, note= removes "
              "it\n"
              "cnf <name> [eth<i>|wlan<i>|A|B] angle=<degrees>, 0 top, 90 "
              "right\n"
              "cnf <a2b> A2B|B2A delay|loss|rate|silentms|qsize|bsize=<n>\n"
              "cnf <nat> publish=hostport:guestport[/udp]|none\n"
              "cnf <cnt> [cpu=<percent of a core>] [ram=<megabytes>], 0 lifts "
              "a cap\n"
              "cnf <lan> rstp=on|off\n"
              "cnf <c2c> mac_mangle=xx:xx:xx:xx:xx:xx")

def build_note(a):
    """cnf <name> note=<text>: the rest of the line is the text, quoted or
    not, so it is read before the line is split on its spaces."""
    text = " ".join(a[1:])[len("note="):]
    if len(text.encode()) > MAX_NOTE:
        sys.exit("cnf %s: a note holds %d bytes at most, this one has %d"
                 % (a[0], MAX_NOTE, len(text.encode())))
    if any(ord(c) < 0x20 or ord(c) == 0x7f for c in text):
        sys.exit("cnf %s: a note is one line of printable text" % a[0])
    return {"fctident": "item_note", "tid": 0, "name": a[0], "txt": text}

def build_cnf(a):
    """cnf <name> [<interface>|A2B|B2A] key=value ... -> its message."""
    if len(a) >= 2 and a[1].startswith("note="):
        return build_note(a)
    if any(w.startswith("note=") for w in a[2:]):
        sys.exit("cnf %s: note= comes alone, right after the name"
                 % spoken(a))
    # "A2B delay=100" given as one word is the same line
    a = a[:1] + " ".join(a[1:]).split()
    if len(a) < 2:
        return None
    name, rest = a[0], a[1:]
    if rest[0] in A2B_DIR:
        return {"fctident": "a2b_cnf", "tid": 0, "name": name,
                "cmd": a2b_cmd(rest)}
    num = None
    if is_iface(rest[0]):
        num, rest = iface_num(rest[0]), rest[1:]
    kv, flags, pos = parse_kv(rest)
    kinds = set(CNF_KEYS.get(k) for k in kv)
    if flags or pos or len(kinds) != 1 or None in kinds:
        sys.exit("cnf %s: not a setting cloonix knows\n%s"
                 % (spoken(a), CNF_SYNTAX))
    kind = kinds.pop()
    if num is not None and kind not in ("sniff", "angle"):
        sys.exit("cnf %s: an interface is named for sniff= and angle= only"
                 % spoken(a))
    try:
        if kind == "place":
            return {"fctident": "item_pos", "tid": 0, "name": name,
                    "x": int(kv["x"][-1]), "y": int(kv["y"][-1])}
        if kind == "angle":
            return {"fctident": "item_poseth", "tid": 0, "name": name,
                    "num": num or 0, "deg": int(one(kv, "angle"))}
    except KeyError:
        sys.exit("cnf %s: x= and y= together" % spoken(a))
    except ValueError:
        sys.exit("cnf %s: whole numbers" % spoken(a))
    if kind == "sniff":
        val = {"on": 1, "off": 0}.get(one(kv, "sniff"))
        if val is None:
            sys.exit("cnf %s: sniff=on or sniff=off" % spoken(a))
        return {"fctident": "snf_add", "tid": 0, "name": name,
                "num": num or 0, "val": val}
    if kind == "nat":
        return {"fctident": "nat_cnf", "tid": 0, "name": name,
                "cmd": "publish=" + build_nat_ports(kv)}
    if kind == "cnt":
        # a cap not named keeps its value
        cmd = []
        if "cpu" in kv:
            cmd.append("cpu=%d" % whole(one(kv, "cpu"), "cpu"))
        if "ram" in kv:
            cmd.append("ram=%d" % megabytes(one(kv, "ram"), "ram"))
        return {"fctident": "cnt_cnf", "tid": 0, "name": name,
                "cmd": " ".join(cmd)}
    if kind == "lan":
        if one(kv, "rstp") not in ("on", "off"):
            sys.exit("cnf %s: rstp=on or rstp=off" % spoken(a))
        return {"fctident": "lan_cnf", "tid": 0, "name": name,
                "cmd": "rstp=" + one(kv, "rstp")}
    return {"fctident": "c2c_cnf", "tid": 0, "name": name,
            "cmd": "mac_mangle=" + one(kv, "mac_mangle")}

ENDP_TYPE = {
    13: "none",  14: "eth-s",  15: "eth-v",
    16: "tap-s", 17: "tap-v",  18: "nat-s", 19: "nat-v",
    20: "c2c-s", 21: "c2c-v",
    22: "phya-s", 23: "phya-v", 24: "phym-s", 25: "phym-v",
    26: "a2b",
}

def render_topo_short(topo):
    """The topology as names, kinds and the lans that join them.

    A lan named under two interfaces is a cable; a lan under one only is a
    cable with an end missing.
    """
    out = []
    net = topo.get("network", "?")
    kinds = (("cnt", "cnt"), ("kvm", "kvm"), ("c2c", "c2c"), ("tap", "tap"),
             ("nat", "nat"), ("a2b", "a2b"), ("phy", "phy"))
    out.append("net %s" % net)
    total = 0
    for key, label in kinds:
        for obj in topo.get(key, []) or []:
            name = obj.get("name", "?")
            extra = ""
            if key in ("cnt", "kvm"):
                extra = " eth=%d" % obj.get("nb_tot_eth", 0)
                if obj.get("ping_ok") == 0:
                    extra += " (not answering)"
            out.append("  %-4s %-20s%s" % (label, name, extra))
            total += 1
    if not total:
        out.append("  (no objects)")
    phys = topo.get("info_phy", []) or []
    if phys:
        out.append("  host interfaces a phy can take: %s" % " ".join(phys))

    # lan -> the interfaces on it, those of a cnt or kvm by their name
    guests = set(obj.get("name") for key in ("cnt", "kvm")
                 for obj in topo.get(key, []) or [])
    a2bs = set(obj.get("name") for obj in topo.get("a2b", []) or [])
    lans = {}
    for e in topo.get("endp", []) or []:
        nm, num = e.get("name", "?"), e.get("num", 0)
        if nm in guests:
            who = "%s eth%d" % (nm, num)
        elif nm in a2bs and num in (0, 1):
            who = "%s %s" % (nm, "AB"[num])
        else:
            who = nm if num == 0 else "%s %d" % (nm, num)
        kind = ENDP_TYPE.get(e.get("type", 0), "type %s" % e.get("type"))
        for lan in e.get("lans", []) or []:
            lans.setdefault(lan, []).append("%s (%s)" % (who, kind))
    if lans:
        out.append("  lans:")
        for lan in sorted(lans):
            ends = lans[lan]
            # Only a lan with a single member is worth flagging.
            mark = "   <-- ONLY ONE END" if len(ends) == 1 else ""
            out.append("    %-14s %s%s" % (lan, ", ".join(ends), mark))
    else:
        out.append("  lans: (none)")
    return "\n".join(out)

def render_ovs(reply):
    """The lines the ovs tool printed, as it printed them.

    No reformatting: the shape of fdb/show and of dump-ports is what a
    person already knows from running them by hand, and a client that
    rearranged it would make the two look like different tools."""
    lines = [i for i in reply.get("items", [])]
    while lines and not lines[-1].strip():
        lines.pop()
    if not lines:
        return "(nothing came back)"
    return "\n".join(lines)

def render_pid(reply):
    """dump pid: every process of the net, and its cost.

    cpu is the average over the life of the process, of one core, as the %CPU
    of ps: two processors flat read 200.0. An older server sends no cpu and no
    rss: the columns are then zero, said once at the foot.
    """
    items = reply.get("items") or []
    if not items:
        return "(nothing came back)"
    npad = max(len(str(i.get("name", ""))) for i in items)
    npad = max(npad, 4)
    out = ["  %-*s %8s %8s %12s" % (npad, "name", "pid", "cpu%", "rss")]
    out.append("  " + "-" * (npad + 31))
    total_rss = 0
    measured = False
    for item in items:
        cpu = item.get("cpu")
        rss = item.get("rss")
        if cpu or rss:
            measured = True
        total_rss += (rss or 0)
        out.append("  %-*s %8s %8s %12s"
                   % (npad, item.get("name", ""), item.get("pid", 0),
                      "%.1f" % ((cpu or 0) / 10.0),
                      "%.1f M" % ((rss or 0) / 1024.0)))
    out.append("  " + "-" * (npad + 31))
    out.append("  %-*s %12s"
               % (npad + 18,
                  "%d process%s" % (len(items),
                                    "" if len(items) == 1 else "es"),
                  "%.1f M" % (total_rss / 1024.0)))
    if not measured:
        out.append("")
        out.append("  no cpu or rss came back: this server predates them.")
    return "\n".join(out)

def render_images(reply):
    """dump images: everything add can take, and its owner.

    A persistent container writes into its image, which must then belong to the
    user who runs the net; any image serves read only. A qcow2 is copied on
    write: its owner is shown, the persistent column does not apply.
    """
    items = reply.get("items") or []
    runner = reply.get("runner", "")
    if not items:
        return "  bulk holds nothing add can take"
    npad = max(len(i.get("name", "")) for i in items)
    out = ["  %-6s %-*s %-12s %s" % ("kind", npad, "name", "owner",
                                    "persistent")]
    for i in sorted(items, key=lambda x: (x.get("kind"), x.get("name"))):
        kind, name, owner = i.get("kind"), i.get("name", ""), i.get("owner")
        if kind != "cnt":
            pers = "-"
        elif owner == runner:
            pers = "possible"
        else:
            pers = "no, the net runs as %s" % runner
        out.append("  %-6s %-*s %-12s %s" % (kind, npad, name, owner, pers))
    return "\n".join(out)

