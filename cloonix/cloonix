def pcap_link_type(hdr):
    """Link type out of the 24 byte pcap file header, either byte order."""
    if len(hdr) < 24:
        return -1
    magic = int.from_bytes(hdr[0:4], "little")
    little = magic in (0xa1b2c3d4, 0xa1b23c4d)
    return int.from_bytes(hdr[20:24], "little" if little else "big")

def spaced_bytes(data):
    """The packet as one byte per field: two hex digits, one space between.

    The line splits on whitespace, every field at a fixed index:

        f = line.split()
        nb, when = int(f[1]), float(f[2])
        pkt = bytes(int(x, 16) for x in f[4:])
    """
    return " ".join("%02x" % b for b in data)

def hex_dump(pkt_nb, sec, usec, t_zero, caplen, wire_len, data):
    """The packet as the raw pane of webshark shows it, byte for byte.

    The layout of renderHex() in webshark.html, a four digit offset, sixteen
    bytes in hex, the printable characters with a dot for the rest, so a packet
    looks the same here and in the browser. The heading has what this side
    knows: the number, the absolute and relative times, the two lengths;
    source, destination and protocol are left to the dissectors of webshark.
    """
    rel = (sec + usec / 1000000.0) - t_zero
    out = ["No. %-6d Time %d.%06d (+%.6f)   Length %d captured of %d"
           % (pkt_nb, sec, usec, rel, caplen, wire_len)]
    for off in range(0, len(data), 16):
        chunk = data[off:off+16]
        hexs = " ".join("%02x" % b for b in chunk).ljust(47)
        asc = "".join(chr(b) if 0x20 <= b < 0x7f else "." for b in chunk)
        out.append("%04x   %s   %s" % (off, hexs, asc))
    out.append("")
    return "\n".join(out) + "\n"

TRACE_KIND = {
    "qemu": (1, "the command line every kvm is created with"),
    "json_cli": (2, "every json message the server receives and sends"),
    "crun": (3, "the command line every container is launched with"),
    "nspace": (4, "the namespaces containers are given and give up"),
}

# probe: a trace subscribing to nothing, hence not in the table above.
TRACE_WORDS = "|".join(TRACE_KIND) + "|probe"

def do_trace(ip, port, passwd, argv, nets=None, local_net=None):
    """cli <net> trace <kind>: report a kind of event as it happens.

    It subscribes and stays until ctrl-c, one block per event. dump says what
    the server has now, trace what it does from now on: start it, then make the
    thing happen.
    """
    if not argv:
        sys.stderr.write("trace wants a kind: %s\n" % TRACE_WORDS)
        return 2
    word = argv[0]
    if word not in TRACE_KIND:
        sys.stderr.write("no trace called '%s', pick one of %s\n"
                         % (word, TRACE_WORDS))
        return 2
    kind = TRACE_KIND[word][0]
    try:
        door = Doorways(ip, port, passwd, None)
    except OSError as err:
        what, why, hints = connect_error(ip, port, err, local_net)
        return fault(what, why, hints)
    try:
        pending = []
        door.send_json({"fctident": "trace_sub", "tid": 0,
                        "kind": kind, "sub_on": 1})
        while True:
            reply = door.recv_json()
            if reply is None:
                sys.stderr.write("the server closed the connection\n")
                return 1
            ident = reply.get("fctident", "")
            if ident == "status_ko":
                why = reply.get("reason") or reply.get("txt") or "(none given)"
                sys.stderr.write("refused by the cloonix server: %s\n" % why)
                return 1
            if ident == "status_ok":
                break
            if ident == "trace":
                # A trace before the acknowledgement means the subscription is
                # live.
                pending.append(reply)
                break
        # No timeout from here: nothing happening is not an error, it is a net
        # where nothing is being created, and this verb exists to wait.
        door.sock.settimeout(None)
        sys.stdout.write("# waiting for %s, ctrl-c to stop\n"
                         % TRACE_KIND[word][1])
        sys.stdout.write("# what happened before this subscription is not"
                         " reported\n")
        sys.stdout.flush()
        while True:
            reply = pending.pop(0) if pending else door.recv_json()
            if reply is None:
                sys.stderr.write("the server closed the connection\n")
                return 1
            ident = reply.get("fctident", "")
            if ident == "status_ko":
                why = reply.get("txt") or reply.get("reason") or "(none given)"
                sys.stderr.write("refused by the cloonix server: %s\n" % why)
                return 1
            if ident != "trace" or reply.get("kind") != kind:
                continue
            # The name on its own line and the command verbatim on the next,
            # so the second line pastes into a shell as it stands.
            sys.stdout.write("%s %s\n%s\n\n"
                             % (word, reply.get("name", "?"),
                                reply.get("txt", "")))
            sys.stdout.flush()
    except KeyboardInterrupt:
        try:
            door.send_json({"fctident": "trace_sub", "tid": 0,
                            "kind": kind, "sub_on": 0})
        except Exception:
            pass
        sys.stdout.write("\n")
        return 0
    except IOError as err:
        if isinstance(err, BrokenPipeError) and stdout_gone():
            raise
        sys.stderr.write("%s\n" % err)
        return 2
    finally:
        door.close()

SNIFF_OPEN_TRIES = 10
SNIFF_OPEN_PAUSE = 0.5

def sniff_open_answer(door, pending):
    """None once the server says yes to a pcap_open, or why it said no."""
    while True:
        reply = door.recv_json()
        if reply is None:
            return "the server closed the connection"
        ident = reply.get("fctident", "")
        if ident == "status_ko":
            return reply.get("reason") or reply.get("txt") or "(none given)"
        if ident == "status_ok":
            return None
        if ident == "pcap_traffic":
            # Traffic before the acknowledgement means the subscription is
            # plainly live, so stop waiting -- but KEEP the packet.
            pending.append(reply)
            return None

def sniffed_in(lines, name, itf):
    """True when dump commands has <name> [<itf>] sniff=on."""
    return any(len(w) > 5 and w[3] == "cnf" and w[4] == name and
               w[5:-1] == ([itf] if itf else []) and w[-1] == "sniff=on"
               for w in lines)

def sniff_arm(door, name, num):
    """cnf <name> [<interface>] sniff=on on the connection of the sniff:
    0 once the server says it is done."""
    door.send_json({"fctident": "snf_add", "tid": 0, "name": name,
                    "num": num, "val": 1})
    door.sock.settimeout(ACK_BY_VERB["cnf"])
    try:
        while True:
            reply = door.recv_json()
            if reply is None:
                return 1
            ident = reply.get("fctident", "")
            if ident in ("status_ok", "status_ko"):
                return 0 if ident == "status_ok" else 1
    except socket.timeout:
        return 1
    finally:
        door.sock.settimeout(None)

def do_sniff(ip, port, passwd, argv, nets=None, local_net=None):
    """cli <net> sniff <name> [ethN|wlanN|A|B]: the packets of an interface.

    It subscribes and waits, one line per packet until ctrl-c, on the stream
    the cloonix-dumpcap of that snf serves, multiplexed on the doors
    connection. With --line:

        hdr <48 hex chars>                 the pcap file header, once
        pkt <n> <sec>.<usec> <caplen>/<len> <hex of the packet>

    <n> counts from 1 for this subscription; a gap is packets the server
    dropped because this connection was behind, 8 MB queued. --count decodes
    nothing and prints every second what arrived and what was dropped.
    """
    modes = []
    args = list(argv)
    for flag, mode in (("--dump", "dump"), ("--bytes", "bytes"),
                       ("--line", "line"), ("--count", "count")):
        while flag in args:
            args.remove(flag)
            if mode not in modes:
                modes.append(mode)
    if len(modes) > 1:
        sys.stderr.write("pick one of --dump, --bytes, --line, --count, "
                         "not %s\n"
                         % " ".join("--" + m for m in modes))
        return 2
    mode = modes[0] if modes else "dump"
    if not args:
        sys.stderr.write("sniff wants a name, then eth<i> or wlan<i> of a "
                         "guest, A or B of an a2b\n")
        return 2
    name = args.pop(0)
    # the interface is left out for an item of one interface, an air too
    iface = args.pop(0) if (args and is_iface(args[0])) else ""
    num = iface_num(iface) if iface else 0
    # Everything after the interface is the filter, joined back into one
    # string.
    filt = " ".join(args)
    t_zero = None
    try:
        door = Doorways(ip, port, passwd, None)
    except OSError as err:
        what, why, hints = connect_error(ip, port, err, local_net)
        return fault(what, why, hints)
    try:
        # Anything that arrives during the handshake and is not part of it.
        pending = []
        armed = False
        tries = 0
        # what dump commands says first, so a nominal sniff is never refused
        lines = commands_now(door)
        if iface.startswith("wlan") and lan_of(lines, name, iface):
            air = lan_of(lines, name, iface)
            sys.stderr.write("cloonix: %s %s is captured with its air, "
                             "sniffing %s\n" % (name, iface, air))
            name, iface, num = air, "", 0
        if not sniffed_in(lines, name, iface):
            armed = True
            said = spoken([name] + ([iface] if iface else []))
            if not sniff_arm(door, name, num):
                sys.stderr.write("cloonix: %s was not sniffed, done now: "
                                 "cnf %s sniff=on\n" % (said, said))
        while True:
            door.send_json({"fctident": "pcap_open", "tid": 0,
                            "name": name, "num": num, "filter": filt})
            why = sniff_open_answer(door, pending)
            if why is None:
                break
            # a wlan is captured with its air: the air is sniffed
            if "is captured with its air: sniff " in why and iface:
                air = why.rsplit(" ", 1)[1]
                sys.stderr.write("cloonix: %s %s is captured with its air, "
                                 "sniffing %s\n" % (name, iface, air))
                name, iface, num = air, "", 0
                continue
            # Not sniffed: the user asked to sniff it, so it is made so.
            if not armed and ("not sniffed" in why or "not captured" in why):
                armed = True
                said = spoken([name] + ([iface] if iface else []))
                if sniff_arm(door, name, num):
                    sys.stderr.write("refused by the cloonix server: %s\n"
                                     % why)
                    return 1
                sys.stderr.write("cloonix: %s was not sniffed, done now: "
                                 "cnf %s sniff=on\n" % (said, said))
                continue
            # Armed a moment ago: its capture may still be starting.
            tries += 1
            if not armed or tries > SNIFF_OPEN_TRIES:
                sys.stderr.write("refused by the cloonix server: %s\n" % why)
                return 1
            time.sleep(SNIFF_OPEN_PAUSE)

        # No timeout from here: a quiet interface is not an error, it is an
        # interface with nothing on it, and this verb exists to wait.
        door.sock.settimeout(None)
        cnt_pkt = cnt_bytes = cnt_gap = 0
        tot_pkt = tot_bytes = tot_gap = 0
        last_nb = 0
        cnt_t0 = t_start = time.time()
        if filt:
            sys.stdout.write("# waiting on %s %d for packets matching: %s\n"
                             % (name, num, filt))
            sys.stdout.write("# everything else is dropped by the server and"
                             " never crosses the wire\n")
        else:
            sys.stdout.write("# waiting for packets on %s %d, ctrl-c to"
                             " stop\n" % (name, num))
        sys.stdout.flush()
        while True:
            reply = pending.pop(0) if pending else door.recv_json()
            if reply is None:
                sys.stderr.write("the server closed the connection\n")
                return 1
            ident = reply.get("fctident", "")
            if ident == "status_ko":
                why = reply.get("txt") or reply.get("reason") or "(none given)"
                sys.stderr.write("refused by the cloonix server: %s\n" % why)
                return 1
            if ident != "pcap_traffic":
                continue
            if reply.get("name") != name or reply.get("num") != num:
                continue
            if mode == "count":
                # Nothing decoded: the cheapest consumer there is, to see what
                # the chain delivers and what it dropped on the way.
                if reply.get("type", 1) == 0:
                    continue
                nb = reply.get("pkt_nb", 0)
                if last_nb and nb > last_nb + 1:
                    cnt_gap += nb - last_nb - 1
                last_nb = nb
                cnt_pkt += 1
                cnt_bytes += reply.get("len", 0)
                now = time.time()
                if now - cnt_t0 >= 1.0:
                    dt = now - cnt_t0
                    sys.stdout.write("%d pkt/s  %.1f Mbit/s  %d dropped\n"
                                     % (cnt_pkt / dt, cnt_bytes * 8 / dt / 1e6,
                                        cnt_gap))
                    sys.stdout.flush()
                    tot_pkt += cnt_pkt
                    tot_bytes += cnt_bytes
                    tot_gap += cnt_gap
                    cnt_pkt = cnt_bytes = cnt_gap = 0
                    cnt_t0 = now
                continue
            try:
                raw_bytes = base64.b64decode(reply.get("data", ""))
            except Exception:
                sys.stderr.write("a packet did not decode, skipped\n")
                continue
            if reply.get("type", 1) == 0:
                if mode == "line":
                    sys.stdout.write("hdr %s\n" % raw_bytes.hex())
                elif mode == "bytes":
                    sys.stdout.write("hdr %s\n" % spaced_bytes(raw_bytes))
                else:
                    sys.stdout.write("# pcap file header, link type %d\n"
                                     % pcap_link_type(raw_bytes))
                sys.stdout.flush()
                continue
            sec  = reply.get("sec", 0)
            usec = reply.get("usec", 0)
            if t_zero is None:
                t_zero = sec + usec / 1000000.0
            if mode in ("line", "bytes"):
                body = (raw_bytes.hex() if mode == "line"
                        else spaced_bytes(raw_bytes))
                sys.stdout.write("pkt %d %d.%06d %d/%d %s\n"
                                 % (reply.get("pkt_nb", 0), sec, usec,
                                    reply.get("caplen", len(raw_bytes)),
                                    reply.get("len", len(raw_bytes)),
                                    body))
            else:
                sys.stdout.write(hex_dump(reply.get("pkt_nb", 0), sec, usec,
                                          t_zero,
                                          reply.get("caplen", len(raw_bytes)),
                                          reply.get("len", len(raw_bytes)),
                                          raw_bytes))
            sys.stdout.flush()
    except KeyboardInterrupt:
        try:
            door.send_json({"fctident": "pcap_close", "tid": 0,
                            "name": name, "num": num})
        except Exception:
            pass
        if mode == "count":
            tot_pkt += cnt_pkt
            tot_bytes += cnt_bytes
            tot_gap += cnt_gap
            dt = max(time.time() - t_start, 0.001)
            sys.stdout.write("total %d packets %.1f MB in %.1fs: %d pkt/s "
                             "%.1f Mbit/s, %d dropped on the way\n"
                             % (tot_pkt, tot_bytes / 1e6, dt, tot_pkt / dt,
                                tot_bytes * 8 / dt / 1e6, tot_gap))
        sys.stdout.write("\n")
        return 0
    except IOError as err:
        if isinstance(err, BrokenPipeError) and stdout_gone():
            raise
        sys.stderr.write("%s\n" % err)
        return 2
    finally:
        door.close()

# A cnf may start a process too (a snf for sniff=on, a passt for publish=),
# and the server answers when it is up.
ACK_BY_VERB = {
    "add":    60.0,
    "del":    30.0,
    "plug":   30.0,
    "unplug": 30.0,
    "cnf":    30.0,
    "save":   60.0,
}
ACK_DEFAULT = 2.0

ACK_MUST_ANSWER = ("add", "del", "plug", "unplug", "cnf", "save")

# The wait of a question that is not a mutation, and of every connect.
WAIT_DEFAULT = 15.0

def ack_budget(argv, wait):
    """Seconds to wait for the answer of a mutation: --wait, when given."""
    if wait is not None:
        return wait
    if argv[:2] == ["dump", "ip"]:
        return ACK_BY_VERB["cnf"]
    return ACK_BY_VERB.get(argv[0] if argv else "", ACK_DEFAULT)

def spoken(argv):
    """The command as it was typed, for a message about it."""
    return " ".join(str(a) for a in argv)

# What is said when a verb does not succeed.
EXIT_OK, EXIT_REFUSED, EXIT_LOCAL, EXIT_BUG = 0, 1, 2, 3

CTX = {"argv": [], "net": "", "ip": "", "port": 0}

def ctx_set(**kw):
    CTX.update((k, v) for k, v in kw.items() if v not in (None, ""))

def fault(what, reason="", hints=(), code=EXIT_LOCAL):
    """Print the standard block and give back the exit code.

    what   -- one line, what did not happen
    reason -- the detail, usually from the far end or from the OS
    hints  -- commands to try, printed as commands
    """
    out = ["cloonix: %s" % what]
    if CTX["argv"]:
        out.append("  asked : %s" % spoken(CTX["argv"]))
    where = ""
    if CTX["net"]:
        where = "net %s" % CTX["net"]
    if CTX["ip"]:
        where += "%sthe server at %s:%s" % (" -- " if where else "",
                                            CTX["ip"], CTX["port"])
    if where:
        out.append("  where : %s" % where)
    if reason:
        for i, line in enumerate(str(reason).rstrip().splitlines()):
            out.append("  %s %s" % ("reason:" if i == 0 else "       ", line))
    for h in hints:
        out.append("  try   : %s" % h)
    sys.stderr.write("\n".join(out) + "\n")
    return code

def refused(ip, port, argv, msg, reply):
    """The server said no. Print what was asked and what came back."""
    why = reply.get("txt") or reply.get("reason") or ""
    sys.stderr.write("REFUSED by the cloonix server at %s:%d\n" % (ip, port))
    sys.stderr.write("  asked : %s\n" % spoken(argv))
    sys.stderr.write("  reason: %s\n" % (why or "(the server gave none)"))
    if why and why == msg.get("name"):
        sys.stderr.write("  that is the object name and nothing else, so "
                         "the server has no '%s'\n" % why)
    if why.startswith("CNT ERROR"):
        sys.stderr.write("  the container was refused by suid_power; the "
                         "lines before its refusal are in the server log:\n")
        sys.stderr.write("    bundle: sudo journalctl -b | grep -i "
                         "\"suid\\|crun\"\n")
        sys.stderr.write("    toy:    ./<net>cmd shell, then "
                         "grep -i \"suid\\|crun\" /var/log/syslog\n")
    return 1

def no_answer(ip, port, argv, msg, budget, waited=0.0):
    """Nothing came back. Silence is NOT success for these verbs.

    It was, and that is the whole reason this function exists: an add that
    the server refused three seconds later printed nothing and exited 0,
    and every script built on that exit code believed it.
    """
    verb = argv[0] if argv else ""
    if verb not in ACK_MUST_ANSWER and argv[:2] != ["dump", "ip"]:
        return 0
    sys.stderr.write("NO ANSWER from the cloonix server at %s:%d "
                     "after %.1fs (waited up to %gs)\n"
                     % (ip, port, waited, budget))
    sys.stderr.write("  asked : %s\n" % spoken(argv))
    if waited < budget * 0.5:
        sys.stderr.write("  It came back well before the wait ran out, so "
                         "the server closed the\n"
                         "  connection rather than took too long.\n")
    else:
        sys.stderr.write("  This verb is answered when it has worked and "
                         "when it has failed,\n"
                         "  so neither happened in that time.\n")
    sys.stderr.write("  What the server has now:\n")
    sys.stderr.write("    cloonix cli <net> dump commands\n")
    sys.stderr.write("  The server side:\n")
    sys.stderr.write("    bundle: sudo journalctl -b | grep -i "
                     "\"cloonix\\|suid\\|crun\"\n")
    sys.stderr.write("    toy:    ./<net>cmd shell, then grep -i "
                     "\"cloonix\\|suid\\|crun\" /var/log/syslog\n")
    sys.stderr.write("  Longer, if the machine is simply slow:\n")
    sys.stderr.write("    cloonix --wait %g cli ...\n" % (budget * 4))
    return 1

def commands_now(door):
    """The lines of dump commands, one round trip, answered on the spot."""
    door.send_json({"fctident": "list_commands_req", "tid": 0,
                    "is_layout": 0})
    while True:
        got = door.recv_json()
        if got is None:
            return []
        if got.get("fctident") == "list_commands_resp":
            return [l.split() for l in got.get("items") or []]

def lan_of(lines, name, itf):
    """The lan, or air, of an interface as dump commands has it, "" on
    none. A wlan on the air of its kind is in no plug line."""
    kind, nb_wlan = "", 0
    for w in lines:
        if len(w) < 6 or w[4] != name and w[5:6] != [name]:
            continue
        if w[3] == "add" and w[5] == name:
            kind = w[4]
            nb_wlan = int(dict(x.split("=", 1) for x in w if "=" in x)
                          .get("wlan", 0))
        elif w[3] == "plug" and w[4] == name and w[5:-1] == ([itf] if itf
                                                            else []):
            return w[-1]
        elif w[3] == "unplug" and w[4] == name and w[5:6] == [itf]:
            return ""
    if itf.startswith("wlan") and int(itf[4:]) < nb_wlan:
        return CNTWIFI if kind == "cnt" else KVMWIFI
    return ""

def cable_first(door, msg, budget, itf):
    """What the net settles before a plug or an unplug: an unplug without
    a lan finds it, a plug onto the lan it is on is done already, a plug of
    an eth cabled elsewhere unplugs it first. None to go on, else the exit
    code."""
    name = msg["name"]
    said = " ".join([name] + ([itf] if itf else []))
    now = lan_of(commands_now(door), name, itf)
    if msg["fctident"] == "del_lan_endp":
        if not msg["lan"]:
            if not now:
                sys.stderr.write("cloonix: %s is on no lan, nothing to "
                                 "unplug\n" % said)
                return 0
            msg["lan"] = now
        return None
    if now == msg["lan"]:
        sys.stderr.write("cloonix: %s is on %s already\n" % (said, now))
        return 0
    # a wlan changes air in one move of the server
    if not now or itf.startswith("wlan"):
        return None
    got = cable_ask(door, dict(msg, fctident="del_lan_endp", lan=now), budget)
    if got.get("fctident") != "status_ok":
        return fault("%s: the unplug from %s was refused" % (said, now),
                     got.get("txt") or "no answer", (), EXIT_REFUSED)
    got = cable_ask(door, msg, budget)
    if got.get("fctident") == "status_ok":
        sys.stderr.write("cloonix: %s was on %s, moved to %s\n"
                         % (said, now, msg["lan"]))
        return 0
    # refused where it was going: put back where it was
    back = cable_ask(door, dict(msg, lan=now), budget)
    return fault("%s: the plug onto %s was refused" % (said, msg["lan"]),
                 got.get("txt") or got.get("reason") or "no answer",
                 () if back.get("fctident") == "status_ok" else
                 ("cloonix cli %s plug %s %s" % (CTX["net"] or "<net>", said,
                                                 now),), EXIT_REFUSED)

def cable_ask(door, msg, budget):
    """One plug or unplug and its answer, {} when none came."""
    door.send_json(msg)
    door.sock.settimeout(budget)
    while True:
        try:
            got = door.recv_json()
        except socket.timeout:
            return {}
        if got is None:
            return {}
        if got.get("fctident") in ("status_ok", "status_ko"):
            return got

def cable(ip, port, door, argv, msg, budget, raw):
    """A plug or an unplug, asked again while the same interface is being
    cabled or uncabled by an earlier request."""
    itf = argv[2] if len(argv) > 2 and is_iface(argv[2]) else ""
    deadline = time.time() + budget
    while True:
        said = cable_first(door, msg, budget, itf)
        if said is not None:
            return said
        got = cable_ask(door, msg, max(deadline - time.time(), 1.0))
        why = got.get("txt") or got.get("reason") or ""
        if got.get("fctident") != "status_ko" or \
           not ("is being" in why or "already waiting" in why) or \
           time.time() > deadline:
            break
        time.sleep(0.5)
    if not got:
        return no_answer(ip, port, argv, msg, budget, budget)
    if got.get("fctident") == "status_ko":
        return refused(ip, port, argv, msg, got)
    if raw:
        print(json.dumps(got, indent=2, sort_keys=True))
    return 0

def do_msg(ip, port, passwd, argv, timeout, raw, wait=None,
           nets=None, local_net=None):
    """Send one message, and print what comes back.

    argv[0] is the verb, the net having been resolved by the caller. Only
    dump waits for an answer of its own; everything else is a mutation and
    the server says status_ok or nothing.
    """
    if not argv:
        return 2

    if argv[0] == "rpc":
        if len(argv) != 2:
            sys.stderr.write("rpc wants one json argument\n")
            return 2
        try:
            msg = json.loads(argv[1])
        except ValueError as err:
            sys.stderr.write("that is not valid json: %s\n" % err)
            return 2
        expect = None
    else:
        msg = to_json(argv, nets, local_net)
        if msg is None:
            sys.stderr.write("cannot map that to a message: %s\n"
                             % " ".join(argv))
            return 2
        # to_json has already refused a dump with nothing after it, so argv[1]
        # is there whenever the verb is dump.
        if argv[0] == "dump":
            expect = ("ovs_cmd_resp"
                      if (argv[1] in OVS_TOOLS or argv[1] == "namespaces")
                      else EXPECT.get(argv[1]))
        else:
            expect = None

    try:
        door = Doorways(ip, port, passwd, timeout)
    except OSError as err:
        what, why, hints = connect_error(ip, port, err, local_net)
        return fault(what, why, hints)
    try:
        # a wlan is captured with its air: the air is armed
        if argv[0] == "cnf" and msg.get("fctident") == "snf_add" and \
           msg.get("num", 0) >= WLAN_NUM_BASE:
            itf = "wlan%d" % (msg["num"] - WLAN_NUM_BASE)
            air = lan_of(commands_now(door), msg["name"], itf)
            if not air:
                return fault("%s %s is on no air, nothing to capture"
                             % (msg["name"], itf))
            sys.stderr.write("cloonix: %s %s is captured with its air: cnf "
                             "%s sniff=%s\n" % (msg["name"], itf, air,
                             "on" if msg["val"] else "off"))
            msg = dict(msg, name=air, num=0)
        # rpc is sent as it is
        if argv[0] != "rpc" and \
           msg.get("fctident") in ("add_lan_endp", "del_lan_endp"):
            return cable(ip, port, door, argv, msg, ack_budget(argv, wait),
                         raw)
        if msg.get("fctident") == "c2c_add":
            door.send_json(msg, val=DOORS_VAL_C2C)
        else:
            door.send_json(msg)
        if expect is None:
            budget = ack_budget(argv, wait)
            deadline = time.time() + budget
            reply = None
            while True:
                left = deadline - time.time()
                if left <= 0:
                    break
                door.sock.settimeout(left)
                got = door.recv_json()
                if got is None:
                    break
                ident = got.get("fctident", "")
                if ident in ("status_ok", "status_ko"):
                    reply = got
                    break
                if "raw" in got:
                    sys.stderr.write("undecodable answer from the server: "
                                     "%r\n" % got["raw"][:300])
                if raw:
                    print(json.dumps(got, indent=2, sort_keys=True))

            if reply is None:
                return no_answer(ip, port, argv, msg, budget,
                                 budget - max(deadline - time.time(), 0))

            ident = reply.get("fctident", "")
            if ident == "status_ko":
                return refused(ip, port, argv, msg, reply)
            if raw:
                print(json.dumps(reply, indent=2, sort_keys=True))
            # whatip= is a question: its answer is the text of the ok
            elif str(msg.get("cmd", "")).startswith("whatip="):
                said = reply.get("txt") or reply.get("reason") or ""
                print(said[3:] if said.startswith("OK=") else said)
            return 0
        while True:
            reply = door.recv_json()
            if reply is None:
                return fault(
                    "no answer to %s within the %gs timeout" % (argv[0],
                                                               timeout),
                    "the server never sent a %s" % expect,
                    ("cloonix --wait 60 cli %s %s" % (CTX["net"] or "<net>",
                                                      spoken(argv)),
                     "cloonix cli %s dump commands" % (CTX["net"] or "<net>")),
                    EXIT_REFUSED)
            if reply.get("fctident") == expect:
                if expect == "ovs_cmd_resp" and not raw:
                    print(render_ovs(reply))
                    return 1 if reply.get("status") else 0
                if argv[1] == "pid" and not raw:
                    print(render_pid(reply))
                elif argv[1] == "images" and not raw:
                    print(render_images(reply))
                elif argv[1] == "commands" and not raw:
                    # One command per line, so the output is the script the
                    # help says it is: sh on it rebuilds the net.
                    print("\n".join(reply.get("items") or []))
                elif argv[1] == "topo" and not raw:
                    print(render_topo_short(reply))
                elif argv[1] == "drawing" and not raw:
                    print(render_atop(reply))
                else:
                    print(json.dumps(reply, indent=2, sort_keys=True))
                return 0
    except IOError as err:
        if isinstance(err, BrokenPipeError) and stdout_gone():
            raise
        sys.stderr.write("%s\n" % err)
        return 2
    finally:
        door.close()

class GuestLeg(Doorways):
    """A doorways leg wired through to a program inside one guest."""

    def __init__(self, ip, port, passwd, vm, timeout=15):
        self.vm = vm
        Doorways.__init__(self, ip, port, passwd, timeout)

    def _open_link(self):
        req = "DBSSH_CLI_DOORS_REQ name=%s cookie=%s wire=%d\0" % (
              self.vm, CXP_COOKIE, CLOONIX_WIRE_VERSION)
        self.send_raw(req.encode("utf-8"), type_=DOORS_TYPE_DBSSH,
                      val=DOORS_VAL_INIT_LINK)
        got = self.recv()
        if got is None:
            raise IOError("no answer to the leg request: wrong password, or "
                          "the server is not listening")
        _type, val, payload = got
        txt = payload.decode("utf-8", "replace").rstrip("\0")
        if val == DOORS_VAL_LINK_KO or txt.startswith("KO"):
            raise IOError("cloonix refused the leg to '%s': %s" % (self.vm, txt))
        if not txt.startswith("OK"):
            raise IOError("unexpected answer to the leg request: %r" % txt)

    def write(self, data):
        """Raw bytes toward the program inside the guest."""
        if isinstance(data, str):
            data = data.encode()
        room = MAX_BUF - HDR
        while data:
            self.send_raw(data[:room], type_=DOORS_TYPE_DBSSH,
                          val=DOORS_VAL_NONE)
            data = data[room:]

    def read(self):
        """Next chunk of raw bytes from the guest, or None at end."""
        got = self.recv()
        if got is None:
            return None
        _type, val, payload = got
        if val in (DOORS_VAL_LINK_OK, DOORS_VAL_INIT_LINK):
            return b""
        return payload

class UnixLeg:
    """The same read/write contract as GuestLeg, but straight onto a unix
    socket. Used with --via-unix to exercise cloonix-cxp-srv on its own,
    inside the guest or on a workstation, with no cloonix in the path."""

    def __init__(self, path, timeout=15):
        self.timeout = timeout
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(timeout)
        self.sock.connect(path)

    def write(self, data):
        if isinstance(data, str):
            data = data.encode()
        self.sock.sendall(data)

    def read(self):
        try:
            data = self.sock.recv(65536)
        except socket.timeout:
            return b""
        return data if data else None

    def no_timeout(self):
        self.sock.settimeout(None)

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass

def do_probe(ip, port, passwd, vm, timeout):
    """cli <net> trace probe <guest>: where the pipe into a guest breaks.

    ssh, scp and files cross five layers: the tcp to proxymous, the hmac of
    every frame, the leg routed by guest name, the agent on the virtio channel,
    the program the agent hands the bytes to. This crosses them one at a time
    and prints how far it got. cloonix-cxp-srv never speaks first, so silence
    at the far end is the healthy answer; recv.quiet tells a silence from a
    close.
    """
    wait = min(timeout, 5.0)
    print("probe '%s' through the cloonix at %s:%d" % (vm, ip, port))

    def step(name, verdict, note=""):
        print("  %-20s %-14s %s" % (name, verdict, note))

    try:
        leg = GuestLeg(ip, port, passwd, vm, timeout)
    except OSError as err:
        # IOError is OSError in python3, so the two cannot be told apart by
        # type.
        if getattr(err, "errno", None) is not None:
            step("tcp to proxymous", "FAILED", err)
            print("\nnothing is listening there, so no layer above it was "
                  "reached and the")
            print("guest is not implicated at all.")
            print("  try   : cloonix start %s"
                  % (CTX["net"] or "<net>"))
        else:
            step("tcp to proxymous", "ok", "something is listening")
            step("leg to '%s'" % vm, "FAILED", err)
            print("\nthe tcp is up, so the server is refusing the leg and "
                  "the network is not")
            print("at fault. Three things do that: a cloonix_passwd this "
                  "server does not")
            print("share, a guest name it does not have, or a wire version "
                  "it does not")
            print("speak.")
            print("  try   : cloonix cli %s dump topo   the guests it does "
                  "have" % (CTX["net"] or "<net>"))
        return 2

    step("tcp to proxymous", "ok", "something is listening")
    step("hmac on the frame", "ok", "the cloonix_passwd of this net matches")
    step("leg to '%s'" % vm, "ok", "the server knows the guest and routed it")

    try:
        got, quiet = b"", False
        deadline = time.time() + wait
        while True:
            left = deadline - time.time()
            if left <= 0:
                quiet = True
                break
            leg.sock.settimeout(left)
            data = leg.read()
            if data is None:
                quiet = leg.quiet
                break
            if data:
                got = data
                break

        if quiet:
            step("agent + virtio", "ok", "the leg stayed up for %.1fs" % wait)
            step("far end", "silent", "which is what cloonix-cxp-srv does")
            print("\nthe pipe is whole end to end. ssh, scp and files to "
                  "'%s' have nothing" % vm)
            print("in their way, so a failure of one of those is in what it "
                  "asks for and")
            print("not in how it gets there.")
            return 0

        if not got:
            step("agent + virtio", "ok", "the server routed the leg")
            step("far end", "CLOSED", "it hung up without a word")
            print("\nthe guest side dropped the leg, so the agent could not "
                  "hand the bytes")
            print("to cloonix-cxp-srv inside '%s': it is not running there, "
                  "or the" % vm)
            print("insider-agents iso in that guest is not the one this "
                  "client speaks to.")
            return 1

        step("agent + virtio", "ok", "%d bytes came back" % len(got))
        if got.startswith(b"SSH-"):
            step("far end", "WRONG", bytes(got[:40]))
            print("\nthat is an ssh banner, so the far end is dropbear and "
                  "not cloonix-cxp-srv.")
            print("Every layer under it works. Build and install the "
                  "insider-agents iso and")
            print("reboot '%s' -- the program comes from the iso, so no "
                  "guest image has to" % vm)
            print("be rebuilt.")
            return 1

        step("far end", "spoke first", bytes(got[:40]))
        print("\ncloonix-cxp-srv is silent until it is spoken to, so "
              "something else is on")
        print("the other end of the cookie. The bytes above are what it "
              "said.")
        return 1
    finally:
        leg.close()

OP_EXEC, OP_PTY, OP_STDIN, OP_EOF, OP_WINCH = 1, 2, 3, 4, 5
OP_PUT, OP_DATA, OP_END, OP_GET = 6, 7, 8, 9
OP_STDOUT, OP_STDERR, OP_EXIT, OP_ERROR = 0x81, 0x82, 0x83, 0x84
OP_META, OP_GDATA, OP_GEND = 0x85, 0x86, 0x87
OP_PUTTREE, OP_ENTRY, OP_GETTREE, OP_GENTRY = 0x0A, 0x0B, 0x0C, 0x8B
OP_LIST = 0x0D

class Cxp:
    """The message layer above a GuestLeg."""

    def __init__(self, leg):
        self.leg = leg
        self.buf = bytearray()
        self.greeted = None
        self.lock = threading.Lock()
        # Where a transfer really landed, from the EXIT payload of the guest.
        self.exit_info = {}

    def send(self, op, payload=b""):
        if isinstance(payload, dict):
            payload = json.dumps(payload, separators=(",", ":")).encode()
        elif isinstance(payload, str):
            payload = payload.encode()
        with self.lock:
            self.leg.write(struct.pack(">IB", len(payload) + 1, op) + payload)

    def recv(self):
        """(op, payload) or None when the pipe closes."""
        while True:
            # The first four bytes say whether this is a frame at all.
            if (self.greeted is None) and (len(self.buf) >= 4):
                self.greeted = bytes(self.buf[:4])
                if self.greeted == b"SSH-":
                    raise NeedCxp()
            if len(self.buf) >= 5:
                ln = struct.unpack(">I", self.buf[:4])[0]
                if len(self.buf) >= 4 + ln:
                    op = self.buf[4]
                    payload = bytes(self.buf[5:4 + ln])
                    del self.buf[:4 + ln]
                    return op, payload
            chunk = self.leg.read()
            if chunk is None:
                return None
            self.buf += chunk

    def pump(self, on_out, on_err):
        """Run until EXIT or ERROR. Returns the exit code."""
        while True:
            got = self.recv()
            if got is None:
                return 255
            op, payload = got
            if op == OP_STDOUT:
                on_out(payload)
            elif op == OP_STDERR:
                on_err(payload)
            elif op == OP_EXIT:
                try:
                    info = json.loads(payload.decode())
                except ValueError:
                    return 0
                self.exit_info = info if isinstance(info, dict) else {}
                return int(self.exit_info.get("code", 0))
            elif op == OP_ERROR:
                try:
                    txt = json.loads(payload.decode()).get("txt", "")
                except ValueError:
                    txt = payload.decode("utf-8", "replace")
                sys.stderr.write("guest: %s\n" % txt)
                return 255

def start_stdin_thread(cxp):
    """Pump our stdin into the running command, then close it. A command that
    reads stdin, wc for instance, needs the EOF or it waits for ever; one that
    ignores stdin is unaffected. The thread is a daemon, so it never holds the
    process open after the command has exited."""
    def run():
        try:
            while True:
                # os.read, not sys.stdin.buffer: a daemon thread parked in a
                # BufferedReader holds its lock at interpreter exit.
                data = os.read(0, 32768)
                if not data:
                    break
                cxp.send(OP_STDIN, data)
        except (OSError, ValueError):
            pass
        try:
            cxp.send(OP_EOF)
        except (OSError, IOError):
            pass
    t = threading.Thread(target=run, daemon=True)
    t.start()
    return t

def term_size():
    try:
        import shutil
        sz = shutil.get_terminal_size((80, 24))
        return sz.columns, sz.lines
    except Exception:
        return 80, 24

_WIN_STD_INPUT          = 0xFFFFFFF6      # -10
_WIN_STD_OUTPUT         = 0xFFFFFFF5      # -11
_WIN_INVALID_HANDLE     = -1
_WIN_ENABLE_PROCESSED_INPUT   = 0x0001   # ctrl-c handled locally
_WIN_ENABLE_LINE_INPUT        = 0x0002   # wait for the return key
_WIN_ENABLE_ECHO_INPUT        = 0x0004   # print what is typed
_WIN_ENABLE_VIRTUAL_TERMINAL_INPUT = 0x0200   # keys as escape sequences
_WIN_ENABLE_VIRTUAL_TERMINAL_PROCESSING = 0x0004  # honour escapes on output

def _win_raw_mode_on():
    """The windows half of raw_mode_on. Two handles have to be changed, not
    one: the input handle so that keys arrive unbuffered, unechoed and as
    escape sequences rather than as key events, and the output handle so
    that the escapes the guest sends are acted on instead of printed. The
    second is what makes vtysh, top and anything full screen usable."""
    try:
        import ctypes
        from ctypes import wintypes
    except ImportError:
        return None
    try:
        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        k32.GetStdHandle.argtypes = [wintypes.DWORD]
        k32.GetStdHandle.restype = wintypes.HANDLE
        k32.GetConsoleMode.argtypes = [wintypes.HANDLE,
                                       ctypes.POINTER(wintypes.DWORD)]
        k32.GetConsoleMode.restype = wintypes.BOOL
        k32.SetConsoleMode.argtypes = [wintypes.HANDLE, wintypes.DWORD]
        k32.SetConsoleMode.restype = wintypes.BOOL

        hin = k32.GetStdHandle(_WIN_STD_INPUT)
        hout = k32.GetStdHandle(_WIN_STD_OUTPUT)
        if (not hin) or (not hout):
            return None
        if (hin == _WIN_INVALID_HANDLE) or (hout == _WIN_INVALID_HANDLE):
            return None
        in_mode = wintypes.DWORD()
        out_mode = wintypes.DWORD()
        # GetConsoleMode fails when the handle is not a console at all -- a
        # pipe, or the mintty terminal that git bash uses.
        if not k32.GetConsoleMode(hin, ctypes.byref(in_mode)):
            return None
        if not k32.GetConsoleMode(hout, ctypes.byref(out_mode)):
            return None
        new_in = in_mode.value
        new_in &= ~(_WIN_ENABLE_PROCESSED_INPUT |
                    _WIN_ENABLE_LINE_INPUT |
                    _WIN_ENABLE_ECHO_INPUT)
        new_in |= _WIN_ENABLE_VIRTUAL_TERMINAL_INPUT
        new_out = out_mode.value | _WIN_ENABLE_VIRTUAL_TERMINAL_PROCESSING
        if not k32.SetConsoleMode(hin, new_in):
            return None
        if not k32.SetConsoleMode(hout, new_out):
            k32.SetConsoleMode(hin, in_mode.value)
            return None
        return ("win", k32, hin, in_mode.value, hout, out_mode.value)
    except Exception:
        return None

def raw_mode_on():
    """Hand every keystroke straight to the guest: no local echo, no line
    buffering, no local interpretation of ctrl-c. Returns what to restore,
    or None when there is no terminal to change (a pipe, or a console the
    api refused). Windows is handled too, through the console api, since it
    has no termios: without it an interactive shell keeps local echo and
    line buffering and nothing full screen works."""
    if not sys.stdin.isatty():
        return None
    try:
        import termios, tty
    except ImportError:
        return _win_raw_mode_on()
    try:
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        tty.setraw(fd)
        return ("posix", fd, saved)
    except Exception:
        return None

def raw_mode_off(saved):
    if not saved:
        return
    try:
        if saved[0] == "win":
            _, k32, hin, in_mode, hout, out_mode = saved
            k32.SetConsoleMode(hin, in_mode)
            k32.SetConsoleMode(hout, out_mode)
            return
        import termios
        _, fd, attrs = saved
        termios.tcsetattr(fd, termios.TCSADRAIN, attrs)
    except Exception:
        pass

def _winch_poll(cxp):
    """Windows has no SIGWINCH, so the size is watched instead of waited on.
    A daemon thread, half a second apart, sending only on a change: nothing
    to stop at the end, and no traffic while the window sits still."""
    def loop():
        last = term_size()
        while True:
            time.sleep(0.5)
            try:
                now = term_size()
            except Exception:
                return
            if now == last:
                continue
            last = now
            try:
                cxp.send(OP_WINCH, {"cols": now[0], "rows": now[1]})
            except (OSError, IOError):
                return
            except Exception:
                return
    th = threading.Thread(target=loop)
    th.daemon = True
    th.start()

def winch_on(cxp):
    """Tell the guest when the local window is resized, so full screen
    programs inside it redraw at the right size."""
    if not hasattr(signal, "SIGWINCH"):
        _winch_poll(cxp)
        return

    def handler(_sig, _frm):
        cols, rows = term_size()
        try:
            cxp.send(OP_WINCH, {"cols": cols, "rows": rows})
        except (OSError, IOError):
            pass
    try:
        signal.signal(signal.SIGWINCH, handler)
    except (ValueError, OSError):
        _winch_poll(cxp)

def human(n):
    """A size a person reads at a glance."""
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if (n < 1024.0) or (unit == "GB"):
            if unit == "B":
                return "%d B" % int(n)
            return "%.1f %s" % (n, unit)
        n /= 1024.0

class Progress:
    """One line, rewritten in place, while a transfer runs: on stderr, only
    when stderr is a terminal, so stdout stays what the command produced.
    """

    GAP = 0.15

    def __init__(self, what, total=None):
        self.on = sys.stderr.isatty()
        self.what = what
        self.total = total
        self.done = 0
        self.items = 0
        self.t0 = time.time()
        self.last = 0.0

    def item(self):
        self.items += 1

    def add(self, n):
        self.done += n
        self._show(False)

    def _line(self):
        el = time.time() - self.t0
        out = "%s  %s" % (self.what, human(self.done))
        if self.total:
            out += " / %s  %d%%" % (human(self.total),
                                    int(100.0 * self.done /
                                        max(self.total, 1)))
        if self.items:
            out += "  %d file%s" % (self.items,
                                    "" if self.items == 1 else "s")
        # Below a fifth of a second the figure is noise, not a rate.
        if el > 0.2:
            out += "  %s/s" % human(self.done / el)
        return out + "  %.1fs" % el

    def _show(self, force):
        if not self.on:
            return
        now = time.time()
        if (not force) and (now - self.last < self.GAP):
            return
        self.last = now
        sys.stderr.write("\r\033[K" + self._line())
        sys.stderr.flush()

    def end(self):
        self._show(True)
        if self.on:
            sys.stderr.write("\n")
            sys.stderr.flush()

class NeedCxp(Exception):
    """The far end greeted with an ssh banner: it is not cloonix-cxp-srv.
    Cxp.recv sees the banner in the first bytes it reads, at no cost when
    there is none.
    """

NEED_CXP = """the guest is still answering with the banner, so the far
end of the pipe is not cloonix-cxp-srv.

Build and install the replacement, then reboot the guest: the program comes
from the insider-agents iso, so no guest image has to be rebuilt.
"""

def do_ssh(mkleg, argv):
    try:
        leg = mkleg()
    except (OSError, IOError) as err:
        sys.stderr.write("%s\n" % err)
        return 2
    try:
        # From here the guest drives the pace, however long it takes.
        leg.no_timeout()
        cxp = Cxp(leg)
        out = sys.stdout.buffer
        err = sys.stderr.buffer
        if len(argv) == 1:
            cmd = argv[0]
        else:
            cmd = " ".join(shlex.quote(a) for a in argv)
        if cmd:
            cxp.send(OP_EXEC, {"cmd": cmd})
            # Forward stdin from a separate thread.
            start_stdin_thread(cxp)
            return cxp.pump(lambda b: (out.write(b), out.flush()),
                            lambda b: (err.write(b), err.flush()))

        # Interactive: a shell on a pty in the guest.
        cols, rows = term_size()
        cxp.send(OP_PTY, {"cmd": "", "cols": cols, "rows": rows})
        saved = raw_mode_on()
        winch_on(cxp)
        try:
            start_stdin_thread(cxp)
            # A pty merges stderr into stdout, exactly as a terminal does.
            return cxp.pump(lambda b: (out.write(b), out.flush()),
                            lambda b: (out.write(b), out.flush()))
        finally:
            raw_mode_off(saved)
    finally:
        leg.close()

def do_scp(mkleg_for, argv):
    """cloonix cli scp [-r] <net> <src> <dst>, one side being <vm>:<path>."""
    recursive = False
    rest = []
    for a in argv:
        if a in ("-r", "-R", "--recursive"):
            recursive = True
        else:
            rest.append(a)
    if len(rest) != 2:
        sys.stderr.write("scp wants a source and a destination\n"
                         "  cloonix cli <net> scp <file> <vm>:<path>\n"
                         "  cloonix cli <net> scp <vm>:<path> <file>\n"
                         "  cloonix cli <net> scp -r <dir> <vm>:<path>\n")
        return 2
    src, dst = rest
    if ":" in src and not src.startswith("/"):
        vm, _, rpath = src.partition(":")
        if recursive:
            return scp_get_dir(mkleg_for(vm), rpath, dst)
        return scp_get(mkleg_for(vm), rpath, dst)
    if ":" in dst and not dst.startswith("/"):
        vm, _, rpath = dst.partition(":")
        if recursive:
            return scp_put_dir(mkleg_for(vm), src, rpath)
        if os.path.isdir(src):
            sys.stderr.write("%s is a directory, add -r to copy it whole\n"
                             % src)
            return 2
        return scp_put(mkleg_for(vm), src, rpath)
    sys.stderr.write("one of the two paths must be <vm>:<path>\n")
    return 2

def scp_put(mkleg, local, rpath):
    try:
        st = os.stat(local)
        src = open(local, "rb")
    except OSError as err:
        sys.stderr.write("%s\n" % err)
        return 2
    try:
        leg = mkleg()
    except (OSError, IOError) as err:
        src.close()
        sys.stderr.write("%s\n" % err)
        return 2
    try:
        # From here the guest drives the pace, however long it takes.
        leg.no_timeout()
        cxp = Cxp(leg)
        prog = Progress(os.path.basename(local), st.st_size)
        cxp.send(OP_PUT, {"path": rpath,
                          "name": os.path.basename(local),
                          "mode": st.st_mode & 0o777,
                          "size": st.st_size})
        try:
            while True:
                chunk = src.read(32768)
                if not chunk:
                    break
                cxp.send(OP_DATA, chunk)
                prog.add(len(chunk))
            cxp.send(OP_END)
        except (OSError, IOError) as err:
            sys.stderr.write("the guest closed the transfer: %s\n" % err)
            return 2
        rc = cxp.pump(lambda b: None,
                      lambda b: sys.stderr.buffer.write(b))
        # After the pump, so the time shown is the whole of it: the guest is
        # still writing the last of the file when our side has finished.
        prog.end()
        landed = cxp.exit_info.get("path", "")
        if (rc == 0) and landed:
            sys.stderr.write("%s\n" % landed)
        return rc
    finally:
        src.close()
        leg.close()

def scp_get(mkleg, rpath, local):
    try:
        leg = mkleg()
    except (OSError, IOError) as err:
        sys.stderr.write("%s\n" % err)
        return 2
    try:
        # From here the guest drives the pace, however long it takes.
        leg.no_timeout()
        cxp = Cxp(leg)
        cxp.send(OP_GET, {"path": rpath})
        if os.path.isdir(local):
            local = os.path.join(local, os.path.basename(rpath))
        prog = Progress(os.path.basename(rpath))
        mode = 0o644
        out = None
        try:
            while True:
                got = cxp.recv()
                if got is None:
                    sys.stderr.write("the pipe closed during the transfer\n")
                    return 2
                op, payload = got
                if op == OP_META:
                    try:
                        meta = json.loads(payload.decode())
                        mode = int(meta.get("mode", 0o644))
                        prog.total = int(meta.get("size", 0)) or None
                    except ValueError:
                        pass
                elif op == OP_GDATA:
                    if out is None:
                        out = open(local, "wb")
                    out.write(payload)
                    prog.add(len(payload))
                elif op == OP_GEND:
                    if out is None:
                        out = open(local, "wb")
                    break
                elif op == OP_ERROR:
                    try:
                        txt = json.loads(payload.decode()).get("txt", "")
                    except ValueError:
                        txt = payload.decode("utf-8", "replace")
                    sys.stderr.write("guest: %s\n" % txt)
                    return 1
        finally:
            if out is not None:
                out.close()
        prog.end()
        try:
            os.chmod(local, mode)
        except OSError:
            pass
        return 0
    finally:
        leg.close()

def load_sibling(name):
    """The module of that name beside this file, or None if it is not there.

    The directory of this file is put on the path rather than trusted to be
    there: python does put the directory of a script first, but not when the
    client is reached through a link, and not under -P."""
    here = os.path.dirname(os.path.realpath(__file__))
    if here not in sys.path:
        sys.path.insert(0, here)
    try:
        return importlib.import_module(name)
    except PermissionError:
        raise SystemExit(
            "%s.py is there but not readable by this shell: it is limited\n"
            "to the group cloonix, and a session opened before you were added\n"
            "to that group does not have it. Open a new terminal, or run:\n"
            "  newgrp cloonix" % name)
    except ImportError:
        return None

def do_files(mkleg_for, argv):
    """cloonix cli <net> files <guest> [<guest>]: two panes, copy between.

    One name: this machine left, the guest right. Two names: two guests, a copy
    going down into a temporary directory here, then up into the other. The
    screen is cloonix_files.py, beside this file.
    """
    if not argv:
        sys.stderr.write("files wants a guest name\n"
                         "cloonix cli <net> files <guest> [<guest>]\n")
        return 2
    files = load_sibling("cloonix_files")
    if not files:
        sys.stderr.write("files needs cloonix_files.py beside this "
                         "client\n")
        return 2
    return files.run(sys.modules[__name__], mkleg_for, argv[:2])

def safe_rel_path(name):
    """Refuse a member name that would escape the destination. Applied to
    what we send and to what the guest sends back."""
    if (not name) or name.startswith("/") or "\\" in name:
        return False
    parts = name.split("/")
    return all(p and p != ".." for p in parts)

def scp_put_dir(mkleg, local, rpath):
    local = local.rstrip("/")
    if not os.path.isdir(local):
        sys.stderr.write("%s is not a directory\n" % local)
        return 2
    base = os.path.basename(local)
    try:
        leg = mkleg()
    except (OSError, IOError) as err:
        sys.stderr.write("%s\n" % err)
        return 2
    try:
        # From here the guest drives the pace, however long it takes.
        leg.no_timeout()
        cxp = Cxp(leg)
        prog = Progress(base)
        cxp.send(OP_PUTTREE, {"path": rpath})

        def entry(rel, path):
            st = os.lstat(path)
            if not safe_rel_path(rel):
                raise ValueError("refusing to send %s" % rel)
            if os.path.islink(path):
                cxp.send(OP_ENTRY, {"name": rel, "type": "l",
                                    "link": os.readlink(path)})
            elif os.path.isdir(path):
                cxp.send(OP_ENTRY, {"name": rel, "type": "d",
                                    "mode": st.st_mode & 0o777})
            elif os.path.isfile(path):
                cxp.send(OP_ENTRY, {"name": rel, "type": "f",
                                    "mode": st.st_mode & 0o777,
                                    "size": st.st_size})
                prog.item()
                with open(path, "rb") as f:
                    while True:
                        chunk = f.read(32768)
                        if not chunk:
                            break
                        cxp.send(OP_DATA, chunk)
                        prog.add(len(chunk))
            # anything else (socket, fifo, device) is skipped

        entry(base, local)
        for root, dirs, files in os.walk(local):
            rel_root = os.path.relpath(root, local)
            prefix = base if rel_root == "." else base + "/" + rel_root
            for d in sorted(dirs):
                entry(prefix + "/" + d, os.path.join(root, d))
            for f in sorted(files):
                entry(prefix + "/" + f, os.path.join(root, f))
        cxp.send(OP_END)
        rc = cxp.pump(lambda b: sys.stdout.buffer.write(b),
                      lambda b: sys.stderr.buffer.write(b))
        prog.end()
        return rc
    except (OSError, ValueError) as err:
        if isinstance(err, BrokenPipeError) and stdout_gone():
            raise
        sys.stderr.write("%s\n" % err)
        return 2
    finally:
        leg.close()

def scp_get_dir(mkleg, rpath, local):
    if not os.path.isdir(local):
        sys.stderr.write("%s must be an existing directory\n" % local)
        return 2
    try:
        leg = mkleg()
    except (OSError, IOError) as err:
        sys.stderr.write("%s\n" % err)
        return 2
    out = None
    try:
        # From here the guest drives the pace, however long it takes.
        leg.no_timeout()
        cxp = Cxp(leg)
        prog = Progress(os.path.basename(rpath.rstrip("/\\")) or rpath)
        cxp.send(OP_GETTREE, {"path": rpath})
        pending_mode = None
        pending_path = None
        while True:
            got = cxp.recv()
            if got is None:
                sys.stderr.write("the pipe closed during the transfer\n")
                return 2
            op, payload = got
            if op == OP_GENTRY:
                if out is not None:
                    out.close()
                    if pending_mode is not None:
                        try:
                            os.chmod(pending_path, pending_mode)
                        except OSError:
                            pass
                    out = None
                try:
                    e = json.loads(payload.decode())
                except ValueError:
                    sys.stderr.write("bad entry from the guest\n")
                    return 1
                name = e.get("name", "")
                if not safe_rel_path(name):
                    sys.stderr.write("guest sent a refused member name: %r\n"
                                     % name)
                    return 1
                dest = os.path.join(local, *name.split("/"))
                kind = e.get("type", "f")
                if kind == "d":
                    os.makedirs(dest, exist_ok=True)
                    try:
                        os.chmod(dest, int(e.get("mode", 0o755)))
                    except OSError:
                        pass
                elif kind == "l":
                    os.makedirs(os.path.dirname(dest), exist_ok=True)
                    if os.path.lexists(dest):
                        os.unlink(dest)
                    os.symlink(e.get("link", ""), dest)
                else:
                    os.makedirs(os.path.dirname(dest), exist_ok=True)
                    out = open(dest, "wb")
                    pending_mode = int(e.get("mode", 0o644))
                    pending_path = dest
                    prog.item()
            elif op == OP_GDATA:
                if out is not None:
                    out.write(payload)
                prog.add(len(payload))
            elif op == OP_GEND:
                break
            elif op == OP_ERROR:
                try:
                    txt = json.loads(payload.decode()).get("txt", "")
                except ValueError:
                    txt = payload.decode("utf-8", "replace")
                sys.stderr.write("guest: %s\n" % txt)
                return 1
        prog.end()
        return 0
    except OSError as err:
        sys.stderr.write("%s\n" % err)
        return 2
    finally:
        if out is not None:
            out.close()
            if pending_mode is not None:
                try:
                    os.chmod(pending_path, pending_mode)
                except OSError:
                    pass
        leg.close()

CLOONFS_ROOTS = ["/cloonix/cloonfs", "/usr/libexec/cloonix/cloonfs"]

def find_cloonfs():
    """The tree the installation put on this machine, or None when cloonix is
    not installed here."""
    for root in CLOONFS_ROOTS:
        if os.path.isfile(os.path.join(root, "etc", "cloonix.cfg")):
            return root
    return None

def server_version(entry, timeout):
    """The CLOONIX_VERSION a running server answers with, or None.

    work_dir_req is answered on the spot by recv_from_client.c, one round trip,
    nothing subscribed; event_topo_sub would wait on a 100 beat timer.
    """
    door = None
    try:
        door = Doorways(entry["cloonix_ip"], int(entry["cloonix_port"]),
                        entry["cloonix_passwd"], timeout)
        door.send_json({"fctident": "work_dir_req", "tid": 0})
        while True:
            reply = door.recv_json()
            if reply is None:
                return None
            if reply.get("fctident") == "work_dir_resp":
                return reply.get("version") or "?"
    except (OSError, IOError, ValueError, KeyError):
        return None
    finally:
        if door:
            door.close()

LIST_WAIT = 5.0

def probe_net(entry, timeout):
    """Ask one net for its version, and time what that took.

    (version, seconds, why) -- version None when the connect or the wire
    failed, why saying what failed; seconds None when nothing came back
    inside the timeout.
    """
    t0 = time.monotonic()
    door = None
    try:
        door = Doorways(entry["cloonix_ip"], int(entry["cloonix_port"]),
                        entry["cloonix_passwd"], timeout)
        door.send_json({"fctident": "work_dir_req", "tid": 0})
        while True:
            reply = door.recv_json()
            if reply is None:
                return None, None, ""
            if reply.get("fctident") == "work_dir_resp":
                return (reply.get("version") or "?",
                        time.monotonic() - t0, "")
    except socket.timeout:
        return None, None, ""
    except (OSError, IOError, ValueError, KeyError) as err:
        # The errno number says nothing the text does not.
        why = getattr(err, "strerror", None) or str(err) or type(err).__name__
        return None, time.monotonic() - t0, why
    finally:
        if door:
            door.close()

def do_list(nets, wait, override=None):
    """Every net of the config, asked at once: its version and how long it
    took. Then this client and the cloonix installed here.

    Every net is given the whole wait; the verb returns before it only when
    every net has answered. wait 0 asks nothing and prints the config alone.
    """
    cfg_nets = nets
    if override:
        ip, port, passwd = resolve(None, nets, override)
        nets = {"-s": {"cloonix_ip": ip, "cloonix_port": str(port),
                       "cloonix_passwd": passwd}}
    got = {}

    def ask(name):
        got[name] = probe_net(nets[name], wait)

    if wait:
        threads = [threading.Thread(target=ask, args=(n,), daemon=True)
                   for n in nets]
        for t in threads:
            t.start()
        end = time.monotonic() + wait
        while time.monotonic() < end and len(got) < len(nets):
            time.sleep(0.05)

    rows = []
    for name in sorted(nets):
        e = nets[name]
        version, secs, why = got.get(name, (None, None, ""))
        if not wait:
            resp, status = "-", "-"
        elif version:
            resp, status = "%.3fs" % secs, "version %s" % version
        elif secs is None:
            resp, status = "> %gs" % wait, "timeout"
        else:
            resp, status = "%.3fs" % secs, "error %s" % why
        rows.append((name, e.get("cloonix_ip", "?"),
                     e.get("cloonix_port", "?"), e.get("cloonix_web", "?"),
                     resp, status))
    head = ("net", "ip", "cli_port", "https", "resp_time", "status")
    pads = [max(len(r[i]) for r in rows + [head]) for i in range(6)]
    line = lambda r: "  ".join("%-*s" % (pads[i], r[i]) for i in range(6))
    width = len(line(head))
    print()
    print("+-" + "-" * width + "-+")
    print("| " + line(head) + " |")
    print("| " + "-" * width + " |")
    for r in rows:
        print("| " + line(r) + " |")
    print("+-" + "-" * width + "-+")
    local_versions(cfg_nets)
    print()
    return 0

def local_versions(nets):
    """This client, and the cloonix installed here.

    The three -- client, installation, server -- can differ and the drift
    is silent otherwise. The client and the config cannot any more, they
    are one file since cloonix_config.py.
    """
    print("  client     %s" % CFG_VERSION)
    root = find_cloonfs()
    if root:
        found, other = "?", None
        try:
            with open(os.path.join(root, "etc", "cloonix.cfg"), "r") as f:
                text = f.read()
            found, other = cfg_version(text), parse_cfg(text)
        except OSError:
            pass
        print("  installed  %s   %s" % (found, root))
        if other is not None and CFG_ORIGIN == "cloonix_config.py":
            differ = sorted(n for n in set(other) | set(nets)
                            if other.get(n) != nets.get(n))
            if differ:
                print("  they disagree on %s -- one of the two was edited "
                      "by hand" % ", ".join(differ))
                print("  %s and %s"
                      % (os.path.join(root, "etc", "cloonix.cfg"),
                         os.path.join(os.path.dirname(
                             os.path.realpath(__file__)),
                             "cloonix_config.py")))

def do_start(argv, nets):
    root = find_cloonfs()
    if not root:
        sys.stderr.write(
            "cloonix is not installed on this machine, so no server can be\n"
            "started here. Looked for:\n  %s\n"
            "Every other verb does without it: they reach a cloonix running\n"
            "somewhere else.\n" % "\n  ".join(
                os.path.join(r, "etc", "cloonix.cfg") for r in CLOONFS_ROOTS))
        return 2
    cfg = os.path.join(root, "etc", "cloonix.cfg")
    binary = os.path.join(root, "bin", "cloonix-main-server")
    if not os.access(binary, os.X_OK):
        sys.stderr.write("ERROR: %s not found\n" % binary)
        return 1
    if not argv:
        try:
            with open(cfg, "r") as f:
                found = sorted(parse_cfg(f.read()))
        except OSError:
            found = sorted(nets)
        sys.stderr.write("start wants a net name: %s\n" % " ".join(found))
        return 1
    try:
        os.execv(binary, [binary, cfg, argv[0]])
    except OSError as err:
        sys.stderr.write("cannot start %s: %s\n" % (binary, err))
        return 1
    return 0

