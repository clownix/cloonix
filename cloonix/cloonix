# The two kinds of "dump" that are not one of DUMP_REQ: one message each, with
# the tool in it.
OVS_TOOLS = ("ovs-vsctl",)

ABBREV_MIN = 3

def unabbrev(word, menu):
    """The whole word, where a short one starts one word of the menu only."""
    if not menu or not word or word in menu or len(word) < ABBREV_MIN:
        return word
    fit = [w for w in menu if w.startswith(word)]
    return fit[0] if len(fit) == 1 else word

def menu_at(fixed):
    """The words this client owns at the place after the ones given."""
    n = len(fixed)
    if n == 0:
        return VERBS
    if fixed[0] != "cli":
        return ()
    if n == 2:
        return CLI_VERBS
    if n == 3:
        verb = fixed[2]
        if verb == "dump":
            return list(DUMP_REQ) + list(OVS_TOOLS) + ["ip", "namespaces"]
        if verb == "trace":
            return TRACE_WORDS.split("|")
        return {"add": ADD_KINDS, "del": DEL_KINDS}.get(verb, ())
    return ()

def expand(words, net=True):
    """The line with every short verb written out in full.

    Read left to right: the menu of a word is the one the word before it
    opened. net is false for -s and --via-unix, which name the server
    themselves; a filler then stands in the place of the net, so the words
    after it keep their index.
    """
    words = list(words)
    hole = not net and words[:1] == ["cli"]
    if hole:
        words.insert(1, "")
    out = []
    for word in words:
        out.append(unabbrev(word, menu_at(out)))
    if hole:
        del out[1]
    return out

USAGE_HEAD = """usage: cloonix <verb> ...

Verb can be:
"""

CLI_USAGE_HEAD = """usage: cloonix cli <net> <verb> ...

Verb can be:
"""

def two_columns(table):
    """A word and its one line, one pair per line.

    Words with nothing to say are put together on one line instead, so a
    list of guest names does not become a column of empty descriptions.
    """
    if not table:
        return ""
    if not any(table.values()):
        return "  " + "  ".join(table) + "\n"
    pad = max(len(w) for w in table) + 2
    return "".join("  %-*s%s\n" % (pad, w, d or "") for w, d in table.items())

def usage():
    return USAGE_HEAD + two_columns(VERBS)

def cli_usage():
    return CLI_USAGE_HEAD + two_columns(CLI_VERBS)

def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("help", "-h", "--help"):
        sys.stdout.write(usage())
        return 0
    # --version is not an option and is not listed: list gives the versions.
    if argv and argv[0] == "--version":
        sys.argv[1] = argv[0] = "list"

    # add_help is off and every option is hidden: argparse parses, it does not
    # describe.
    ap = argparse.ArgumentParser(prog="cloonix", add_help=False,
                                 usage="cloonix <verb> ...")
    ap.add_argument("--cfg", help=argparse.SUPPRESS)
    ap.add_argument("-s", "--server", help=argparse.SUPPRESS)
    # No default: None lets the client pick per verb; a value is the caller's.
    ap.add_argument("--wait", type=float, default=None,
                    help=argparse.SUPPRESS)
    ap.add_argument("--via-unix", metavar="PATH", help=argparse.SUPPRESS)
    ap.add_argument("--raw", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--completion", action="store_true",
                    help=argparse.SUPPRESS)
    ap.add_argument("--complete", action="store_true",
                    help=argparse.SUPPRESS)
    ap.add_argument("--complete-usage", action="store_true",
                    help=argparse.SUPPRESS)
    ap.add_argument("verb", nargs="?", help=argparse.SUPPRESS)
    ap.add_argument("args", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    opt = ap.parse_args()
    timeout = opt.wait if opt.wait is not None else WAIT_DEFAULT

    nets, cfg_origin = load_config(opt.cfg)
    global CFG_ORIGIN
    CFG_ORIGIN = cfg_origin

    if opt.completion:
        return do_complete(nets, [], "hook")
    if opt.complete or opt.complete_usage:
        words = ([opt.verb] if opt.verb else []) + list(opt.args)
        return do_complete(nets, words,
                           "usage" if opt.complete_usage else "words")

    words = ([opt.verb] + list(opt.args)) if opt.verb else []
    if words:
        words = expand(words, net=not (opt.server or opt.via_unix))
        opt.verb, opt.args = words[0], words[1:]
    if not words:
        sys.stdout.write(usage())
    if (sys.stdin.isatty() and sys.stdout.isatty()
            and not opt.server and not opt.via_unix):
        comp = load_sibling("cloonix_completion")
        # A wrong verb too: the guide drops what no place takes and asks again.
        if comp and not comp.line_is_command(sys.modules[__name__], words):
            words = comp.guide(sys.modules[__name__], nets, words,
                               hinted=not words)
            if not words:
                return 2
            opt.verb, opt.args = words[0], words[1:]
    if not opt.verb:
        return 2

    if opt.verb not in VERBS:
        sys.stderr.write("unknown verb '%s'\n%s" % (opt.verb, usage()))
        return 2

    # The one that asks every net and takes none.
    if opt.verb == "list":
        try:
            wait = LIST_WAIT if not opt.args else float(opt.args[0])
        except ValueError:
            sys.stderr.write("list takes a number of seconds, got '%s'\n"
                             % opt.args[0])
            return 2
        return do_list(nets, max(wait, 0.0), opt.server)

    if opt.verb == "start":
        return do_start(opt.args, nets)

    if opt.verb == "stop":
        if opt.server:
            net, rest = None, opt.args
        elif not opt.args:
            sys.stderr.write("stop wants a net name\n")
            return 2
        else:
            net, rest = opt.args[0], opt.args[1:]
        if rest:
            sys.stderr.write("stop takes the net and nothing else\n")
            return 2
        if net is not None and nets and net not in nets:
            return fault("'%s' is not a net of the config" % net,
                         "the nets are: %s" % ", ".join(sorted(nets)))
        ctx_set(net=net, argv=["stop"])
        ip, port, passwd = resolve(net, nets, opt.server)
        ctx_set(ip=ip, port=port)
        return do_msg(ip, port, passwd, ["stop"], timeout, opt.raw,
                      opt.wait, nets, net)

    if opt.verb != "cli":
        sys.stderr.write("unknown verb '%s'\n%s" % (opt.verb, usage()))
        return 2

    # cli: the net is named ONCE, here, and every verb after it is about that
    # net.
    rest = opt.args
    if not (opt.server or opt.via_unix):
        if not rest:
            sys.stderr.write("cli wants a net name\n")
            return 2
        net, rest = rest[0], rest[1:]
    else:
        net = None
    if net is not None and nets and net not in nets:
        hint = ()
        if net in VERBS:
            hint = (("cloonix %s %s" % (net, spoken(rest))).rstrip(),)
        elif net in CLI_VERBS:
            hint = (("cloonix cli <net> %s %s" % (net, spoken(rest))).rstrip(),)
        code = fault("'%s' is not a net of the config" % net,
                     "the nets are: %s" % ", ".join(sorted(nets)), hint)
        if not rest:
            sys.stderr.write(cli_usage())
        return code
    ctx_set(net=net)
    if not rest:
        sys.stderr.write(cli_usage())
        return EXIT_LOCAL
    verb, rest = rest[0], rest[1:]
    ctx_set(argv=[verb] + list(rest))
    if verb not in CLI_VERBS:
        moved = {"ovs-vsctl": "dump", "probe": "trace"}
        if verb in moved:
            code = fault("'%s' is a kind of %s now" % (verb, moved[verb]), "",
                         ("cloonix cli %s %s %s %s" % (net or "<net>",
                                                       moved[verb], verb,
                                                       spoken(rest)),))
            sys.stderr.write(cli_usage())
            return code
        fit = [v for v in CLI_VERBS if verb and v.startswith(verb)]
        near = fit or [v for v in CLI_VERBS if verb
                       and v.startswith(verb[:2])]
        code = fault("no verb called '%s'" % verb,
                     ("a verb may be written short, three letters at least, "
                      "where they fit one verb only: '%s' fits %s"
                      % (verb, ", ".join(fit))) if fit else "",
                     ("cloonix cli %s %s ..." % (net or "<net>", near[0]),)
                     if near else ())
        sys.stderr.write(cli_usage())
        return code

    if opt.via_unix:
        if verb not in ("ssh", "scp", "files"):
            sys.stderr.write("--via-unix is for ssh, scp and files\n")
            return 2
        mkleg_for = lambda _vm: (lambda: UnixLeg(opt.via_unix, timeout))
        if verb == "scp":
            return do_scp(mkleg_for, rest)
        if verb == "files":
            # One socket reaches one guest, so there is no second pane to name
            # here.
            if len(rest) > 1:
                sys.stderr.write("--via-unix reaches one guest: files "
                                 "takes one name with it\n")
                return 2
            return do_files(mkleg_for, rest or ["unix"])
        return do_ssh(mkleg_for(None), rest)

    # demo runs a programme here that drives the server as this client does,
    # so it needs the name of the net and nothing opened towards it.
    if verb == "demo":
        demo = load_sibling("cloonix_demo")
        if not demo:
            sys.stderr.write("demo needs cloonix_demo.py beside this "
                             "client\n")
            return 2
        return demo.run(sys.modules[__name__], net, rest)

    ip, port, passwd = resolve(net, nets, opt.server)
    ctx_set(ip=ip, port=port)

    if verb in ("ssh", "scp", "files"):
        mkleg_for = (lambda vm:
                     lambda: GuestLeg(ip, port, passwd, vm, timeout))
        if verb == "scp":
            return do_scp(mkleg_for, rest)
        if not rest:
            sys.stderr.write("%s wants a guest name\n" % verb)
            return 2
        if verb == "files":
            return do_files(mkleg_for, rest)
        return do_ssh(mkleg_for(rest[0]), rest[1:])

    if verb == "sniff":
        return do_sniff(ip, port, passwd, rest, nets, net)

    if verb == "trace":
        if rest[:1] == ["probe"]:
            if len(rest) < 2:
                sys.stderr.write("trace probe wants a guest name\n")
                return 2
            return do_probe(ip, port, passwd, rest[1], timeout)
        return do_trace(ip, port, passwd, rest, nets, net)

    return do_msg(ip, port, passwd, [verb] + rest, timeout, opt.raw,
                  opt.wait, nets, net)

def stdout_gone():
    """True when stdout is a pipe whose reader has closed: a broken pipe on
    it is the reader's choice, one on a socket is a failure to report."""
    try:
        poll = select.poll()
        poll.register(sys.stdout.fileno(), select.POLLOUT)
        return any(ev & select.POLLERR for _, ev in poll.poll(0))
    except (OSError, ValueError):
        return False


def reader_gone():
    """The reader of stdout has gone (head, less): what is left goes to
    /dev/null, so the flush at exit has nowhere to fail."""
    try:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
    except OSError:
        pass


def flush_out():
    """stdout flushed now, where a closed pipe is caught, not at exit."""
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        reader_gone()
        sys.exit(0)


if __name__ == "__main__":
    try:
        code = main()
        flush_out()
        sys.exit(code)
    except NeedCxp:
        sys.stderr.write(NEED_CXP)
        sys.exit(EXIT_BUG)
    except SystemExit as stop:
        if isinstance(stop.code, str):
            sys.exit(fault(stop.code))
        flush_out()
        raise
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted\n")
        sys.exit(130)
    except BrokenPipeError as err:
        # before OSError, which it is a kind of; a socket's is a failure
        if stdout_gone():
            reader_gone()
            sys.exit(0)
        sys.exit(fault("the connection or a file failed", err,
                       ("cloonix cli %s dump commands"
                        % (CTX["net"] or "<net>"),)))
    except (OSError, IOError) as err:
        sys.exit(fault("the connection or a file failed", err,
                       ("cloonix cli %s dump commands"
                        % (CTX["net"] or "<net>"),)))
    except Exception as err:
        # A traceback is the worst error report there is: it names a line of
        # this client and not one thing the reader can act on.
        code = fault("the client itself broke, which is a bug",
                     "%s: %s" % (type(err).__name__, err),
                     ("cloonix --raw ... to see the whole traceback",),
                     EXIT_BUG)
        if "--raw" in sys.argv:
            import traceback
            traceback.print_exc()
        sys.exit(code)
