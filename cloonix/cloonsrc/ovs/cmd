#!/bin/bash
# set -e: a step that fails must stop this script.
set -e
HERE=`pwd`
OVS=${HERE}
TARGZ=../../../targz_store
./allclean
mkdir -p ${OVS}/bin
tar xvf ${TARGZ}/ovs_*.tar.gz
cd ${HERE}/ovs
rm -rf .git
patch -p1 < ${HERE}/ovs.patch
# No ct timeout policy probe: its dummy policy makes the kernel log "No such
# timeout policy" at every start, and cloonix sets none.
PROBE='backer->rt_support.ct_timeout = check_ct_timeout_policy(backer);'
if grep -qF "${PROBE}" ofproto/ofproto-dpif.c; then
  sed -i "s/ct_timeout = check_ct_timeout_policy(backer);/ct_timeout = false \&\& check_ct_timeout_policy(backer);/" ofproto/ofproto-dpif.c
else
  echo "WARNING ovs: the ct timeout probe line moved, the kernel will log it"
fi
./boot.sh

export CFLAGS=" -mtune=generic -fno-stack-protector -g -DALLOW_EXPERIMENTAL_API -pthread -lm -ldl -lnuma -lpcap -lrt -fPIC -lunwind"

./configure  --prefix=${HERE}
make -j 6
cd ${HERE}

for i in ovsdb-client ovsdb-server ovsdb-tool; do
  cp -vf ${HERE}/ovs/ovsdb/${i} ${OVS}/bin/cloonix-${i}
  strip ${OVS}/bin/cloonix-${i}
done

for i in ovs-vsctl; do
  cp -vf ${HERE}/ovs/utilities/${i} ${OVS}/bin/cloonix-${i}
  strip ${OVS}/bin/cloonix-${i}
done

cp -vf ${HERE}/ovs/vswitchd/ovs-vswitchd ${OVS}/bin/cloonix-ovs-vswitchd
strip ${OVS}/bin/cloonix-ovs-vswitchd

mkdir -p ${OVS}/share/openvswitch
cp -vf ${HERE}/ovs/vswitchd/vswitch.ovsschema ${OVS}/cloonix-vswitch.ovsschema

